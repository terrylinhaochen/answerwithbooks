# Supabase project (anon key is safe to expose in client code)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics / Search Console
# Use a single GA4 ID in PUBLIC_GA_MEASUREMENT_ID or comma-separated IDs in PUBLIC_GA_MEASUREMENT_IDS.
PUBLIC_GA_MEASUREMENT_ID=G-FNWRC3EMV4
PUBLIC_GA_MEASUREMENT_IDS=
PUBLIC_GOOGLE_SITE_VERIFICATION=xFZB90c9egZSAqh5_HxtLdxhxym5yMcHFYwwYtnwrHg

# Official Substack publication signup and embed URLs.
# Leave blank to use the verified Terry Chen publication.
PUBLIC_NEWSLETTER_SIGNUP_URL=
PUBLIC_NEWSLETTER_EMBED_URL=
# Native newsletter signup uses PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.
# Substack URLs are fallbacks only; no automatic subscriber sync.

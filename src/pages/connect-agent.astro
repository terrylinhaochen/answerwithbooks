---
import Base from '../layouts/Base.astro';
---
<Base title="Connect your agent" description="Connect an agent to your private Answer with Books library." path="/connect-agent/" robots="noindex, nofollow">
 <section class="mx-auto max-w-lg px-5 pt-20 pb-24">
  <p class="awb-eyebrow">Answer with Books</p>
  <h1 class="mt-3 font-serif text-4xl">Connect your agent.</h1>
  <p class="mt-5 text-soft">Your agent can read your private books, upload sources, and download skills. Access expires after 30 days; run <code>logout</code> in the CLI to revoke it sooner.</p>
  <p class="mt-4 text-sm text-soft">Only connect if you started <code>answer-with-books login</code>. Check that this code matches your terminal.</p>
  <form data-connect-agent class="mt-7 space-y-5">
   <label class="block" for="agent-code">Terminal code</label>
   <input id="agent-code" name="code" class="awb-input font-mono" required maxlength="14" autocomplete="off" spellcheck="false" placeholder="ABCD-1234-EF56" pattern="[A-Fa-f0-9]{4}-?[A-Fa-f0-9]{4}-?[A-Fa-f0-9]{4}" />
   <p data-agent-account class="text-sm text-soft"></p>
   <button type="submit" data-agent-connect class="awb-pill awb-pill-primary" disabled>Connect agent</button>
   <a href="/login/?from=agent" data-agent-login class="awb-pill awb-pill-primary" hidden>Sign in to connect</a>
   <p data-agent-status role="status" class="text-sm text-soft"></p>
  </form>
 </section>
 <script>
  import {supabase} from '../lib/supabase';
  const form=document.querySelector<HTMLFormElement>('[data-connect-agent]')!;
  const input=form.querySelector<HTMLInputElement>('input')!,button=form.querySelector<HTMLButtonElement>('button')!;
  const status=form.querySelector<HTMLElement>('[data-agent-status]')!,login=form.querySelector<HTMLAnchorElement>('[data-agent-login]')!,account=form.querySelector<HTMLElement>('[data-agent-account]')!;
  const supplied=new URLSearchParams(location.search).get('code');
  try{input.value=supplied||sessionStorage.getItem('answerwithbooks-agent-code')||'';}catch{input.value=supplied||'';}
  const remember=()=>{try{sessionStorage.setItem('answerwithbooks-agent-code',input.value);}catch{}};
  input.addEventListener('input',remember);remember();
  async function refresh(){const {data}=await supabase.auth.getSession();button.hidden=!data.session;button.disabled=!data.session;login.hidden=!!data.session;account.textContent=data.session?'Connecting as '+data.session.user.email:'';}
  void refresh();supabase.auth.onAuthStateChange(()=>{void refresh();});
  form.addEventListener('submit',async event=>{
   event.preventDefault();if(!form.reportValidity())return;button.disabled=true;status.textContent='Connecting…';
   try{
    const {data,error}=await supabase.functions.invoke('book-cli-auth',{body:{action:'approve',code:input.value}});
    if(error){let message='Could not connect. Run login again and check the code.';try{message=(await error.context.json()).error||message;}catch{}throw new Error(message);}
    if(!data.connected)throw new Error('Could not connect. Please retry.');
    status.textContent='Connected. Return to your agent to use your books.';button.hidden=true;input.disabled=true;
    try{sessionStorage.removeItem('answerwithbooks-agent-code');}catch{}
   }catch(error){status.textContent=error instanceof Error?error.message:'Could not connect.';button.disabled=false;}
  });
 </script>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TactileShelf from '../components/TactileShelf.astro';
import BookAgentDemo from '../components/BookAgentDemo.astro';
import BookJacket from '../components/BookJacket.astro';
import AnswerCover from '../components/AnswerCover.astro';
import { bookPalettes } from '../lib/book-palettes';
import '../styles/collector-home.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ActivityPanel from '../components/ActivityPanel.astro';
import QuestionInvite from '../components/QuestionInvite.astro';
import { faqJsonLd } from '../lib/seo';

const { preview = false, shelfLab = false } = Astro.props;
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const answers = (await getCollection('answers')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featuredBooks = books.filter((b) => b.data.featured);
const featuredAnswers = answers.filter((a) => a.data.featured);
const shelfBooks = [
  ...featuredBooks,
  ...books.filter((book) => !featuredBooks.some((featuredBook) => featuredBook.id === book.id)),
].slice(0, 8);
const shelfAnswers = [
  ...featuredAnswers,
  ...answers.filter((answer) => !featuredAnswers.some((featuredAnswer) => featuredAnswer.id === answer.id)),
].slice(0, 6);
const bookById = new Map(books.map((b) => [b.id, b]));
const carouselIds = [
  'how-to-fix-user-interviews-that-are-not-teaching-you-anything',
  'how-to-tell-whether-to-pivot-or-keep-going',
  'how-to-make-a-plan-that-survives-contact-with-reality',
];
const carouselCopy = new Map([
  [
    'how-to-fix-user-interviews-that-are-not-teaching-you-anything',
    {
      title: 'Ask about recent behavior.',
      body: 'The Mom Test turns vague praise into evidence you can act on.',
    },
  ],
  [
    'how-to-tell-whether-to-pivot-or-keep-going',
    {
      title: 'Separate puzzles from anomalies.',
      body: 'Kuhn helps you tell normal iteration from evidence that the whole frame is wrong.',
    },
  ],
  [
    'how-to-make-a-plan-that-survives-contact-with-reality',
    {
      title: 'Keep local facts in the plan.',
      body: 'Seeing Like a State shows why plans fail when messy ground truth gets deleted.',
    },
  ],
]);
const carouselItems = carouselIds
  .map((id) => answers.find((answer) => answer.id === id))
  .filter(Boolean)
  .map((answer) => ({
    answer,
    books: answer.data.books.map((slug) => bookById.get(slug)).filter(Boolean).slice(0, 3),
    copy: carouselCopy.get(answer.id) ?? {
      title: answer.data.question,
      body: answer.data.description,
    },
  }));
const siteDescription = 'Turn books into practical skills for your AI agent. Read a digest, apply its methods to your work, or upload a book to create a reusable skill.';
const homeFaqs = [
  { question: 'What is a skill?', answer: 'A skill gives an agent instructions for applying a book’s methods: useful frameworks, decision rules, checklists, and mistakes to avoid. Supporting reference notes provide context for the task.' },
  { question: 'How do I use a book with my agent?', answer: 'Open a book and choose Copy prompt for your AI. This copies the book notes and instructions to your clipboard. Paste them into your AI chat and describe your task. For an uploaded book, the prompt also includes the generated skill and references. No installation is needed for this copy-and-paste flow.' },
  { question: 'What does uploading a book create?', answer: 'One searchable upload creates a readable book artifact, a reusable skill with supporting references, and a cover. Keep the upload dialog open until saving finishes; processing then continues in the background. Your files and results stay private to your account.' },
  { question: 'How is the public shelf different?', answer: 'Public book pages are editorial digests with agent prompts. The fuller downloadable skill package is generated from your own uploaded source. Public pages do not contain the original book’s full text.' },
  { question: 'Can I keep and reuse the skill?', answer: 'Yes. An uploaded book has Download book & skill, which exports a ZIP with the book artifact, SKILL.md, reference notes, patterns, a cheatsheet, and a glossary. Add those files to an agent that supports skills, or use Copy prompt for your AI for a single task.' },
];

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': 'https://answerwithbooks.com/#website',
    name: 'Answer with Books',
    alternateName: 'answerwithbooks.com',
    url: 'https://answerwithbooks.com/',
    description: siteDescription,
    author: { '@id': 'https://answerwithbooks.com/#organization' },
    publisher: { '@id': 'https://answerwithbooks.com/#organization' },
    inLanguage: 'en',
  },
  {
    '@type': 'Organization',
    '@id': 'https://answerwithbooks.com/#organization',
    name: 'Answer with Books',
    url: 'https://answerwithbooks.com/',
  },
  {
    '@type': 'WebPage',
    '@id': 'https://answerwithbooks.com/#webpage',
    url: 'https://answerwithbooks.com/',
    name: 'Books into skills for your agent',
    description: siteDescription,
    isPartOf: { '@id': 'https://answerwithbooks.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Featured book-grounded answers',
      itemListElement: shelfAnswers.map((answer, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: answer.data.question,
        url: `https://answerwithbooks.com/answers/${answer.id}/`,
      })),
    },
  },
  {
    '@type': 'SiteNavigationElement',
    name: ['Books', 'Guides', 'Skills', 'Subscribe'],
    url: [
      'https://answerwithbooks.com/books/',
      'https://answerwithbooks.com/guides/',
      'https://answerwithbooks.com/tools/',
      'https://answerwithbooks.com/newsletter/',
    ],
  },
  {
    ...faqJsonLd('https://answerwithbooks.com/', homeFaqs),
  },
];
---

<Base
  title="Good books. Better work. | Answer with Books"
  description={siteDescription}
  path={shelfLab ? "/shelf-lab/" : preview ? "/shelf-preview/" : "/"}
  robots={preview || shelfLab ? "noindex, nofollow" : undefined}
  jsonLd={jsonLd}
  theme="collector"
>
  <TactileShelf showControls={shelfLab} />

  <div class="reading-room">
    <section id="home-intro" class="home-section home-intro">
      <div class="home-intro-copy">
        <p class="room-eyebrow">Book knowledge, ready for your agent</p>
        <h1><span>Turn what you read into</span> <em>how you work.</em></h1>
        <p class="room-description">Give your agent the frameworks, questions, and practical rules inside a good book. Turn them into a better interview, a clearer decision, or a plan you can use.</p>
        <div class="home-signup" data-hide-when-signed-in><NewsletterSignup /></div>
      </div>
      <div id="ideas-for-work" class="insight-paper" data-insight-carousel aria-label="Ideas for your work" aria-roledescription="carousel">
        {carouselItems.map((item, slideIndex) => (
          <article data-carousel-slide={slideIndex} hidden={slideIndex !== 0} aria-label={`Insight ${slideIndex + 1} of ${carouselItems.length}`}>
            <div class="paper-heading"><p class="room-eyebrow">Ideas for your work</p><span class="paper-count">0{slideIndex + 1} / 0{carouselItems.length}</span></div>
            <p class="insight-label">A question worth asking</p>
            <h2>{item.answer.data.question}</h2>
            <div class="insight-body">
              <div class="insight-books" aria-label="Source books">
                {item.books.map((book, index) => <a class="small-jacket" href={`/books/${book.id}/`} aria-label={`Read ${book.data.title}`} style={`--lean:${index === 0 ? -7 : 5}deg`}><BookJacket title={book.data.title} author={book.data.author} slug={book.id} color={bookPalettes[book.id]?.cover ?? '#304c44'} loading="lazy" /></a>)}
              </div>
              <div class="insight-takeaway"><p class="room-eyebrow">Useful takeaway</p><h3>{item.copy.title}</h3><p>{item.copy.body}</p></div>
            </div>
            <div class="insight-bottom">
              <div class="insight-dots" role="group" aria-label="Choose an insight">{carouselItems.map((_, dotIndex) => <button type="button" class:list={["insight-dot", {"is-current": dotIndex === slideIndex}]} aria-label={`Show insight ${dotIndex + 1}`} aria-pressed={dotIndex === slideIndex} data-carousel-dot={dotIndex}></button>)}</div>
              <a class="room-link" href={`/answers/${item.answer.id}/`}>Open insight <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <BookAgentDemo books={books} />

    <section id="source-books" class="home-section home-library">
      <div class="section-heading"><div><p class="room-eyebrow">Featured books</p><h2>A few good places<br /> to <em>begin.</em></h2></div><a class="room-link" href="/books/">All {books.length} books <span aria-hidden="true">↗</span></a></div>
      <div class="library-grid">
        {shelfBooks.map((book, index) => <article class="library-book">
          <a class="library-cover" href={`/books/${book.id}/`} aria-label={`Read ${book.data.title}`} style={`--book-well:${index % 3 === 0 ? '#e2e3d6' : index % 3 === 1 ? '#e9e0d2' : '#e0e4df'}`}><span class="library-jacket"><BookJacket title={book.data.title} author={book.data.author} slug={book.id} color={bookPalettes[book.id]?.cover ?? '#304c44'} loading="lazy" /></span><span class="library-open" aria-hidden="true">↗</span></a>
          <div class="library-copy"><p class="room-eyebrow">{book.data.tags[0]?.replaceAll('-', ' ') ?? 'Source book'}</p><h3><a href={`/books/${book.id}/`}>{book.data.title}</a></h3><p class="library-author">{book.data.author}</p><p class="library-description">{book.data.oneLiner}</p></div>
        </article>)}
      </div>
    </section>

    <section id="install" class="home-section home-install">
      <div class="agent-room agent-room-simple">
        <div><h2>Give your agent<br /><em>a useful skill.</em></h2><p>Turn the methods in a book or document into a way to tackle your next task.</p></div>
        <a href="/tools/" class="room-button room-button-light">Explore skills <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="featured-answers" class="home-section home-answers">
      <div class="section-heading"><div><p class="room-eyebrow">Answers from the shelf</p><h2>For the question<br /> <em>on your mind.</em></h2></div><a href="/answers/" class="room-link">All answers <span aria-hidden="true">↗</span></a></div>
      <div class="answer-grid">
        {shelfAnswers.map((answer, index) => <article class="answer-paper"><div class="answer-paper-image"><AnswerCover answer={answer}/></div><div class="answer-paper-copy"><p class="room-eyebrow">Reading note {String(index + 1).padStart(2,'0')} · {answer.data.books.length} {answer.data.books.length === 1 ? 'source book' : 'source books'}</p><h3><a href={`/answers/${answer.id}/`}>{answer.data.question}</a></h3><p>{answer.data.description}</p><a class="room-link" href={`/answers/${answer.id}/`}>Read the answer <span aria-hidden="true">↗</span></a></div></article>)}
      </div>
      <QuestionInvite />
    </section>

    <section id="profile-tracker" class="home-section home-profile">
      <div class="profile-paper"><div class="profile-intro"><p class="room-eyebrow">Your reading life</p><h2>Track what<br /> keeps <em>showing up.</em></h2><p>See the books, answers, and patterns you return to.</p></div><ActivityPanel eyebrow="Profile tracker" title="A visible trail of useful insights." description="Explore insights and see the books and ideas you return to for the situations that keep coming up." compact showDetails={false} class="home-activity" /></div>
    </section>

    <section id="home-faq" class="home-section home-faq">
      <div><p class="room-eyebrow">A little more to know</p><h2>Good questions.<br /><em>Clear answers.</em></h2></div>
      <div class="faq-pages">{homeFaqs.map(item=><details><summary><h3>{item.question}</h3><span class="faq-plus" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>
  </div>

  <script>
    const carousel = document.querySelector<HTMLElement>('[data-insight-carousel]');
    const slides = Array.from(carousel?.querySelectorAll<HTMLElement>('[data-carousel-slide]') ?? []);
    carousel?.addEventListener('click', (event) => {
      const dot = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-carousel-dot]');
      if (!dot) return;
      const index = Number(dot.dataset.carouselDot);
      slides.forEach((slide, i) => { slide.hidden = i !== index; });
      // Keep keyboard focus on the equivalent control in the newly visible slide.
      slides[index]?.querySelector<HTMLButtonElement>(`[data-carousel-dot="${index}"]`)?.focus({preventScroll:true});
    });
  </script>

</Base>

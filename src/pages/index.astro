---
import Base from '../layouts/Base.astro';
import TactileShelf from '../components/TactileShelf.astro';
import ThousandLivesHero from '../components/ThousandLivesHero.astro';
import {printStudyEnabled} from '../lib/print-study.mjs';
import BookAgentDemo from '../components/BookAgentDemo.astro';
import UploadedBookRow from '../components/UploadedBookRow.astro';
import uploadedBooks from '../lib/uploaded-books.json';
import '../styles/collector-home.css';
import AddBookDialog from '../components/AddBookDialog.astro';
import ActivityPanel from '../components/ActivityPanel.astro';
import QuestionInvite from '../components/QuestionInvite.astro';
import InstallSkillDialog from '../components/InstallSkillDialog.astro';
import { faqJsonLd } from '../lib/seo';

const { preview = false, shelfLab = false } = Astro.props;
const books = uploadedBooks;
const shelfBooks = ['shoe-dog','invention-a-life','open','the-whole-story'].map(slug => books.find(book => book.slug === slug)!);
const siteDescription = 'Explore lives and ideas through books. Follow a question through original passages, then connect the reading to your own experience.';
const homeFaqs = [
 {question:'What does the skill do?',answer:'It lets your agent explore the shared books, create a guide around your question, and help connect a reading to your experience.'},
 {question:'How do I begin?',answer:'Install the skill in your agent, or visit Guides to start with a question. You can choose the books and reading time before creating your guide.'},
 {question:'Can I add a book?',answer:'Yes. Upload a book from the Books page. Books and finished guides join the public library; original files are not available for download.'},
 {question:'Where are my books and guides?',answer:'Your books are saved in Profile, and your readings are in Your Guides. Readable books and published guides also appear in the public catalog.'},
];

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': 'https://answerwithbooks.com/#website',
    name: 'Answer with Books',
    alternateName: 'answerwithbooks.com',
    url: 'https://answerwithbooks.com/',
    description: siteDescription,
    author: { '@id': 'https://answerwithbooks.com/#organization' },
    publisher: { '@id': 'https://answerwithbooks.com/#organization' },
    inLanguage: 'en',
  },
  {
    '@type': 'Organization',
    '@id': 'https://answerwithbooks.com/#organization',
    name: 'Answer with Books',
    url: 'https://answerwithbooks.com/',
  },
  {
    '@type': 'WebPage',
    '@id': 'https://answerwithbooks.com/#webpage',
    url: 'https://answerwithbooks.com/',
    name: 'Books into skills for your agent',
    description: siteDescription,
    isPartOf: { '@id': 'https://answerwithbooks.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Featured books',
      itemListElement: shelfBooks.map((book, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: book.title,
        url: `https://answerwithbooks.com/books/read/?id=${book.id}`,
      })),
    },
  },
  {
    '@type': 'SiteNavigationElement',
    name: ['Books', 'Guides', 'Skills', 'Install skill'],
    url: [
      'https://answerwithbooks.com/books/',
      'https://answerwithbooks.com/guides/',
      'https://answerwithbooks.com/tools/',
      'https://answerwithbooks.com/tools/#install-skill',
    ],
  },
  {
    ...faqJsonLd('https://answerwithbooks.com/', homeFaqs),
  },
];
---

<Base
  title="Good books. Better work. | Answer with Books"
  description={siteDescription}
  path={shelfLab ? "/shelf-lab/" : preview ? "/shelf-preview/" : "/"}
  robots={preview || shelfLab ? "noindex, nofollow" : undefined}
  jsonLd={jsonLd}
  theme="collector"
>
  {!shelfLab && <ThousandLivesHero />}
  {shelfLab && <TactileShelf showControls={shelfLab} />}

  <div class="reading-room">
    <BookAgentDemo />

    <section id="source-books" class="home-section home-library">
      <div class="section-heading"><div><p class="room-eyebrow">Featured books</p><h2>A few good places<br /> to <em>begin.</em></h2></div><a class="room-link" href="/books/">All {books.length} books <span aria-hidden="true">↗</span></a></div>
      <div class="library-grid">
        {shelfBooks.map(book => <UploadedBookRow book={book} />)}
      </div>
    </section>

    <section id="install" class="home-section home-install">
      <div class="agent-room agent-room-simple">
        {printStudyEnabled ? <>
          <div class="print-install-copy"><h2>Give your agent<br /><em>a useful skill.</em></h2><p>Turn the methods in a book or document into a way to tackle your next task.</p><button type="button" class="room-button room-button-light" data-open-skill-install aria-haspopup="dialog" aria-controls="skill-install-dialog">Use skill <span aria-hidden="true">↗</span></button></div>
          <div class="print-install-art" aria-hidden="true"><img src="/print-study/reader-globe-lithograph-v3.png" width="1536" height="1024" loading="lazy" alt="" /></div>
        </> : <>
        <div><h2>Give your agent<br /><em>a useful skill.</em></h2><p>Turn the methods in a book or document into a way to tackle your next task.</p></div>
        <button type="button" class="room-button room-button-light" data-open-skill-install aria-haspopup="dialog" aria-controls="skill-install-dialog">Use skill <span aria-hidden="true">↗</span></button>
        </>}
      </div>
    </section>

    <section id="featured-answers" class="home-section home-answers">
      <div class="section-heading"><div><p class="room-eyebrow">A question of your own</p><h2>For the question<br /> <em>on your mind.</em></h2></div><a href="/guides/" class="room-link">All guides <span aria-hidden="true">↗</span></a></div>
      <QuestionInvite />
    </section>

    <section id="profile-tracker" class="home-section home-profile">
      <div class="profile-paper"><div class="profile-intro"><p class="room-eyebrow">Your reading life</p><h2>Track what<br /> keeps <em>showing up.</em></h2><p>See the books, answers, and patterns you return to.</p></div><ActivityPanel eyebrow="Profile tracker" title="A visible trail of useful insights." description="Explore insights and see the books and ideas you return to for the situations that keep coming up." compact showDetails={false} class="home-activity" /></div>
    </section>

    <section id="home-faq" class="home-section home-faq">
      <div><p class="room-eyebrow">A little more to know</p><h2>Good questions.<br /><em>Clear answers.</em></h2></div>
      <div class="faq-pages">{homeFaqs.map(item=><details><summary><h3>{item.question}</h3><span class="faq-plus" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>
  </div>



  <AddBookDialog />
  <InstallSkillDialog />
</Base>

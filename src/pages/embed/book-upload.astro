---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AddBookDialog from '../../components/AddBookDialog.astro';
const books = await getCollection('books');
const catalog = books.map(book => ({ title: book.data.title, author: book.data.author, year: book.data.year, slug: book.id, digestUrl: `https://answerwithbooks.com/books/${book.id}/` }));
---
<Base title="Upload Book" description="Identify a book from its title, cover image, or PDF, then confirm its details and request a digest." robots="noindex, nofollow" readingMode>
  <div class="mx-auto max-w-lg p-6"><a href="https://chenterry.com/reading/" class="text-sm underline">← Back to Reading</a><h1 class="font-serif text-3xl">Upload Book</h1><p class="mt-3 text-soft">Identify the book, confirm the match, and save your request.</p><button type="button" class="awb-pill awb-pill-primary mt-5" data-open-book-request>Upload Book</button><p class="mt-4 text-sm text-soft">Powered by Answer with Books. Confirmed details and email are sent to its book-request service; uploaded files stay on your device.</p></div>
  <section class="mx-auto max-w-lg px-6 pb-8" aria-labelledby="your-additions"><h2 id="your-additions" class="font-serif text-2xl">Your additions</h2><p class="mt-2 text-sm text-soft">Saved on this browser. These requests do not change Terry’s public reading history.</p><ul data-embed-additions class="mt-4 space-y-4"></ul></section>
  <AddBookDialog
 catalog={catalog} title="Upload Book" sourcePath="https://chenterry.com/reading/" bookBaseUrl="https://answerwithbooks.com" />
  <script>
    import { readAdditions } from '../../lib/book-intake';
    const renderAdditions = () => {
      const list = document.querySelector('[data-embed-additions]')!;
      list.replaceChildren();
      for (const book of readAdditions()) {
        const item = document.createElement('li');
        const title = document.createElement('strong'); title.textContent = book.title;
        const info = document.createElement('p'); info.className = 'text-sm text-soft'; info.textContent = `${book.author} · ${book.slug ? 'Reading available' : 'Digest requested'}`;
        item.append(title, info);
        if (book.slug) { const link = document.createElement('a'); link.className = 'text-sm underline'; link.textContent = 'Read →'; const catalog = JSON.parse(document.getElementById('add-book-catalog')!.textContent!); const match = catalog.find((b: {slug?: string}) => b.slug === book.slug); const url = match?.digestUrl || `https://answerwithbooks.com/books/${encodeURIComponent(book.slug)}/`; if (url.startsWith('/reading/') || url.startsWith('https://answerwithbooks.com/books/')) { link.href = url; item.append(link); } }
        list.append(item);
      }
      if (!list.children.length) { const item=document.createElement('li');item.className='text-sm text-soft';item.textContent='No books added yet.';list.append(item); }
    };
    renderAdditions(); window.addEventListener('awb:book-added', renderAdditions);
    // The embedding site can open the shared flow without maintaining another form.
    window.addEventListener('load', () => document.querySelector<HTMLButtonElement>('[data-open-book-request]')?.click());
  </script>
</Base>

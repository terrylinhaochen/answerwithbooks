---
import Base from '../../layouts/Base.astro';
import AddBookDialog from '../../components/AddBookDialog.astro';
import BookAdditions from '../../components/BookAdditions.astro';
---
<Base title="Upload Book" description="Upload a book to create a private reading artifact and reusable skill." robots="noindex, nofollow" readingMode>
 <div class="mx-auto max-w-lg p-6"><a href="https://chenterry.com/reading/" class="text-sm underline">← Back to Reading</a><h1 class="mt-5 font-serif text-3xl">Upload a book</h1><p class="mt-3 text-soft">One source. Your book, its skill, and a cover.</p><button type="button" class="awb-pill awb-pill-primary mt-5" data-open-book-request>Upload a book</button><BookAdditions /></div>
 <AddBookDialog />
</Base>

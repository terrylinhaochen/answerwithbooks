---
import Base from '../layouts/Base.astro';
import AccountNav from '../components/AccountNav.astro';
---
<Base title="Billing" description="Manage AWB credits, skill usage, and receipts." path="/billing/" robots="noindex, follow">
  <section class="awb-section py-7 sm:py-11" data-billing>
    <AccountNav active="billing" />
    <header class="billing-heading"><div><p class="awb-eyebrow">Your account</p><h1 class="mt-3 font-serif text-4xl">Billing</h1><p class="mt-3 text-soft">Credits and usage, across all your skills and API keys.</p></div><button type="button" class="awb-pill" data-refresh-billing>Refresh</button></header>
    <p class="billing-notice" data-billing-status role="status">Checking your account…</p>
    <div data-billing-signin hidden><a href="/login/?next=%2Fbilling%2F" class="awb-pill awb-pill-primary">Sign in to view billing</a></div>
    <p class="billing-notice" data-payment-return hidden>Returning from checkout does not confirm a payment. Your balance updates after Stripe confirms it; refresh if it is still pending.</p>
    <div class="billing-tabs" role="tablist" aria-label="Billing sections">{[['balance','Balance'],['usage','Usage'],['transactions','Transactions'],['receipts','Receipts']].map(([id,label], index) => <button type="button" id={`billing-tab-${id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`billing-panel-${id}`} tabindex={index === 0 ? 0 : -1} data-billing-tab={id}>{label}</button>)}</div>
    <div id="billing-panel-balance" role="tabpanel" aria-labelledby="billing-tab-balance" data-billing-panel="balance">
      <div class="balance-grid">
        <section class="awb-panel balance-card"><h2>Available credits</h2><p class="balance-caption">Ready to spend on managed skills.</p><p class="balance-value" data-billing-amount="availableCents">—</p><button type="button" class="awb-pill awb-pill-primary" data-open-topup disabled>Add credits</button><p class="balance-caption" data-credit-availability>Checking payment availability…</p></section>
        <section class="awb-panel balance-details" aria-label="Spending summary"><div><h2>Reserved for tasks</h2><p class="balance-caption">Set aside for work in progress.</p><p class="balance-subvalue" data-billing-amount="heldCents">—</p></div><div><h2>Spent this month</h2><p class="balance-subvalue" data-billing-amount="spentThisMonthCents">—</p><a href="#usage" data-view-usage>View usage →</a></div></section>
      </div>
      <p class="billing-footnote">One shared balance for all your API keys. Your agent subscription is separate. Top-ups are one-time purchases; auto-reload is not enabled.</p>
      <section class="awb-panel history-panel" data-call-rates hidden aria-labelledby="call-rates-title"><h2 id="call-rates-title" class="mt-6 font-semibold">Per-call rates</h2><p class="billing-footnote">One completed skill request. Internal tool and model calls are included; failed tasks release their hold. Checking progress and reading results are free.</p><ul class="billing-list" data-call-rate-list></ul><p class="billing-footnote">Your agent confirms the current price before starting. Result-based pricing is a separate experiment.</p></section>
    </div>
    <div id="billing-panel-usage" role="tabpanel" aria-labelledby="billing-tab-usage" data-billing-panel="usage" hidden>
      <div class="section-heading"><div><h2>Skill usage</h2><p>Review recent tasks, charges, and results.</p></div><a href="/tools/">Browse skills →</a></div>
      <div class="usage-filters"><label>Period<select data-usage-days><option value="all">All recent tasks</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option></select></label><label>Skill<select data-usage-skill><option value="all">All skills</option></select></label><label>Status<select data-usage-status><option value="all">All statuses</option><option value="completed">Completed</option><option value="running">Running</option><option value="queued">Queued</option><option value="failed">Failed</option></select></label></div>
      <p class="billing-footnote" data-usage-count>Showing your most recent tasks.</p>
      <section class="awb-panel history-panel" aria-label="Recent skill tasks"><p data-billing-empty="usage" class="history-empty">Sign in to see your tasks.</p><ul class="billing-list" data-billing-list="usage"></ul></section>
    </div>
    {['transactions','receipts'].map(id => <div id={`billing-panel-${id}`} role="tabpanel" aria-labelledby={`billing-tab-${id}`} data-billing-panel={id} hidden><div class="section-heading"><div><h2>{id === 'transactions' ? 'Credit transactions' : 'Payment receipts'}</h2><p>{id === 'transactions' ? 'Credits added, task charges, refunds, and adjustments.' : 'Receipts for completed credit purchases.'}</p></div></div><section class="awb-panel history-panel"><p class="history-empty" data-billing-empty={id}>Sign in to see your {id}.</p><ul class="billing-list" data-billing-list={id}></ul></section></div>)}
    <footer class="billing-footer"><a href="/api-keys/">Manage API keys</a><a href="mailto:terrychen2026@u.northwestern.edu?subject=AWB%20billing">Contact billing</a></footer>

    <dialog data-topup-dialog aria-labelledby="topup-title" class="awb-panel billing-dialog"><header class="dialog-heading"><h2 id="topup-title" class="font-serif text-2xl">Add credits</h2><button class="awb-pill" type="button" data-close-topup aria-label="Close add credits">×</button></header>
      <div data-topup-unavailable><p data-topup-unavailable-message class="mt-5 text-sm leading-relaxed text-soft">Checking payment availability…</p><a href="mailto:terrychen2026@u.northwestern.edu?subject=AWB%20credit%20purchases" class="mt-5 awb-pill">Contact billing →</a></div>
      <form data-topup-controls hidden><p class="mt-4 text-sm text-soft" data-topup-help>Secure checkout with Stripe. Payments are collected by Crowdlisten.</p><label class="topup-amount-label" for="topup-amount" data-topup-label>Credit amount</label><select id="topup-amount" class="topup-amount-select" data-topup-amount></select><label class="credit-consent"><input type="checkbox" data-credit-consent required /><span>I agree to the <a class="underline" data-credit-terms target="_blank" rel="noopener noreferrer">credit terms</a>.</span></label><button type="submit" class="awb-pill awb-pill-primary checkout-button" data-topup disabled>Continue to checkout</button><p class="mt-3 text-xs text-faint">Credits are added only after payment is confirmed. This does not enable automatic payments.</p></form>
      <p class="mt-4 text-sm text-soft" data-checkout-status role="status" aria-live="polite"></p>
    </dialog>
    <dialog data-run-dialog aria-labelledby="task-result-title" class="awb-panel billing-dialog result-dialog"><header class="dialog-heading"><h2 id="task-result-title" class="font-serif text-2xl">Task result</h2><button class="awb-pill" type="button" data-close-run aria-label="Close task result">×</button></header><div class="run-copy-actions"><button type="button" class="awb-pill awb-pill-primary" data-copy-run="text" disabled>Copy result</button><button type="button" class="awb-pill" data-copy-run="json" disabled>Copy JSON</button></div><p class="text-sm text-soft mt-3" data-run-copy-status role="status" aria-live="polite"></p><textarea class="run-copy-manual" aria-label="Result text to copy" data-run-copy-manual readonly hidden></textarea><div class="mt-5" data-run-content></div></dialog>
  </section>
</Base>
<script>import '../lib/billing-page';</script>
<style>
.billing-heading,.dialog-heading,.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20px}.billing-heading>button{flex-shrink:0}.billing-notice{margin-top:24px;color:var(--color-soft);font-size:13px;line-height:1.6}.billing-tabs{display:flex;gap:28px;border-bottom:1px solid var(--color-line);margin:28px 0}.billing-tabs button{padding:10px 0 14px;font-size:14px;border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer;color:var(--color-soft)}.billing-tabs button[aria-selected=true]{border-color:var(--color-ink);color:var(--color-ink);font-weight:600}.balance-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:24px}.balance-card,.balance-details{padding:30px}.balance-card h2,.balance-details h2{font-weight:600;font-size:15px}.balance-caption{font-size:13px;line-height:1.6;color:var(--color-soft);margin-top:8px}.balance-value{font-size:44px;line-height:1.2;font-variant-numeric:tabular-nums;margin:26px 0}.balance-subvalue{font-size:28px;margin-top:12px;font-variant-numeric:tabular-nums}.balance-details>div+div{border-top:1px solid var(--color-line);padding-top:22px;margin-top:22px}.balance-details a{display:inline-block;font-size:13px;margin-top:12px}.billing-footnote{font-size:12px;color:var(--color-faint);line-height:1.7;margin:18px 0}.section-heading{margin-bottom:22px}.section-heading h2{font-size:20px;font-weight:600}.section-heading p{font-size:13px;color:var(--color-soft);margin-top:5px}.section-heading>a{font-size:13px;white-space:nowrap}.usage-filters{display:flex;gap:16px;flex-wrap:wrap}.usage-filters label{font-size:12px;color:var(--color-soft);display:grid;gap:7px;min-width:150px}.usage-filters select,.topup-amount-select{border:1px solid var(--color-line);border-radius:8px;padding:10px 12px;background:var(--color-paper,#fff);font-size:14px;color:var(--color-ink);max-width:100%}.history-panel{padding:4px 24px}.history-empty{padding:32px 0;color:var(--color-soft);font-size:14px;line-height:1.7}.billing-list :global(li){display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 0;border-bottom:1px solid var(--color-line)}.billing-list :global(li:last-child){border:0}.billing-list :global(.row-details){flex:1;min-width:0;overflow-wrap:anywhere}.billing-list :global(.row-title){font-size:14px;font-weight:600}.billing-list :global(small){display:block;font-size:12px;color:var(--color-faint);margin-top:6px;line-height:1.6}.billing-list :global(.row-price){font-size:13px;font-variant-numeric:tabular-nums;white-space:nowrap}.billing-list :global(button),.billing-list :global(a){font-size:13px;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.billing-footer{display:flex;gap:24px;border-top:1px solid var(--color-line);padding-top:22px;margin-top:36px;font-size:12px;color:var(--color-soft)}.billing-dialog{width:min(460px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow-y:auto;overflow-x:hidden;padding:28px;margin:auto}.result-dialog{width:min(720px,calc(100vw - 32px))}.topup-amount-label{display:block;font-size:13px;font-weight:600;margin:24px 0 8px}.topup-amount-select{width:100%}.credit-consent{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-soft);margin:24px 0}.credit-consent input{margin-top:3px}.checkout-button{width:100%}button:disabled{opacity:.45;cursor:not-allowed}.run-copy-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.run-copy-manual{width:100%;height:180px;margin-top:12px;padding:12px;font:12px/1.5 monospace;border:1px solid var(--color-line);border-radius:8px}dialog::backdrop{background:#0005;backdrop-filter:blur(3px)}[data-run-content] :global(p){margin:12px 0;color:var(--color-soft);line-height:1.7;overflow-wrap:anywhere}[data-run-content] :global(h3){font-weight:600;margin-top:20px}[data-run-content] :global(pre){white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;margin-top:14px}[hidden]{display:none!important}@media(max-width:600px){.balance-grid{grid-template-columns:1fr;gap:16px}.balance-card,.balance-details{padding:24px}.billing-tabs{gap:0;justify-content:space-between}.billing-tabs button{font-size:13px}.usage-filters{display:grid;grid-template-columns:1fr 1fr;gap:12px}.usage-filters label{min-width:0}.usage-filters label:first-child{grid-column:1/-1}.section-heading{align-items:flex-start}.history-panel{padding:4px 18px}.billing-list :global(li){flex-wrap:wrap;gap:12px}.billing-list :global(.row-details){flex-basis:65%}.billing-list :global(button){margin-left:auto}.billing-dialog{padding:22px}.billing-heading{align-items:flex-start}}
</style>

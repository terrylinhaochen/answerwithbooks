---
import Base from '../layouts/Base.astro';
import AccountNav from '../components/AccountNav.astro';
---
<Base title="Billing" description="Your AWB skill usage, balance, and payment history." path="/billing/" robots="noindex, follow">
  <section class="awb-section py-7 sm:py-11" data-billing>
    <AccountNav active="billing" />
    <header><p class="awb-eyebrow">Your account</p><h1 class="mt-3 font-serif text-4xl">Billing</h1><p class="mt-3 text-soft">One account for your managed skills. Every personal API key shares this balance and task history.</p><div class="billing-links"><a href="/api-keys/">Manage API keys →</a><a href="/tools/">Browse skills →</a></div></header>
    <p class="mt-8 rounded-xl bg-wash p-4 text-sm text-soft" data-billing-status role="status">Checking your account…</p>
    <div class="mt-5" data-billing-signin hidden><a href="/login/" class="awb-pill awb-pill-primary">Sign in to view billing</a></div>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">{[['Available balance','availableCents'],['In progress','heldCents'],['Spent this month','spentThisMonthCents']].map(([label,key]) => <div class="awb-panel p-6"><p class="text-sm text-soft">{label}</p><p class="mt-3 font-serif text-3xl" data-billing-amount={key}>—</p></div>)}</div>
    <div class="mt-6 space-y-3" data-topup-controls hidden>
      <div class="flex flex-wrap items-center gap-3"><label class="text-sm" for="topup-amount" data-topup-label>Add credits</label><select id="topup-amount" class="awb-pill" data-topup-amount></select><button type="button" class="awb-pill awb-pill-primary" data-topup disabled>Continue to checkout</button></div>
      <label class="flex items-start gap-2 text-sm text-soft"><input class="mt-1" type="checkbox" data-credit-consent /> <span>I agree to the <a class="underline" data-credit-terms target="_blank" rel="noopener noreferrer">credit terms</a>.</span></label>
      <p class="text-xs text-faint" data-topup-help>AWB is a Crowdlisten product. Payments are collected by Crowdlisten.</p>
    </div>
    <button type="button" class="mt-4 text-sm underline text-soft" data-refresh-billing>Refresh balance</button>
    <p class="mt-3 text-xs text-faint" data-payment-return hidden>Returning from checkout does not confirm a payment. Your balance updates after Stripe confirms it; refresh if it is still pending.</p>
    <section class="mt-10 awb-panel p-5 sm:p-7" aria-label="Billing history">
      <div class="billing-tabs" role="tablist" aria-label="Billing history">{[['usage','Usage'],['transactions','Transactions'],['receipts','Receipts']].map(([id,label], index) => <button type="button" id={`billing-tab-${id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`billing-panel-${id}`} tabindex={index === 0 ? 0 : -1} data-billing-tab={id}>{label}</button>)}</div>
      {['usage','transactions','receipts'].map((id,index) => <div id={`billing-panel-${id}`} role="tabpanel" aria-labelledby={`billing-tab-${id}`} data-billing-panel={id} hidden={index !== 0}><p class="py-8 text-sm text-soft" data-billing-empty={id}>Connect your account to see your {id}.</p><ul class="billing-list" data-billing-list={id}></ul></div>)}
    </section>
    <p class="mt-6 text-sm leading-relaxed text-faint">Your agent sends a task through AWB’s shared API and retrieves the result. Usage appears here under the account that owns the key. Viewing results or checking progress does not start a new task. Your own agent subscription is separate.</p>
    <dialog data-run-dialog aria-labelledby="task-result-title" class="awb-panel max-h-[85dvh] w-[min(720px,calc(100vw-32px))] overflow-auto p-6 m-auto"><div class="flex items-center justify-between gap-3"><h2 id="task-result-title" class="font-serif text-2xl">Task result</h2><button class="awb-pill" type="button" data-close-run aria-label="Close task result">×</button></div><div class="run-copy-actions"><button type="button" class="awb-pill awb-pill-primary" data-copy-run="text" disabled>Copy result</button><button type="button" class="awb-pill" data-copy-run="json" disabled>Copy JSON</button></div><p class="text-sm text-soft mt-3" data-run-copy-status role="status" aria-live="polite"></p><textarea class="run-copy-manual" aria-label="Result text to copy" data-run-copy-manual readonly hidden></textarea><div class="mt-5" data-run-content></div></dialog>
  </section>
</Base>
<script>import '../lib/billing-page';</script>
<style>
.billing-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:20px;font-size:13px;color:var(--color-soft)}.billing-links a{text-decoration:underline;text-underline-offset:4px}.run-copy-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.run-copy-actions button:disabled{opacity:.45;cursor:default}.run-copy-manual{width:100%;height:180px;margin-top:12px;padding:12px;font:12px/1.5 monospace;border:1px solid var(--color-line);border-radius:8px}
</style>
<style>.billing-tabs{display:flex;gap:8px;border-bottom:1px solid var(--color-line)}.billing-tabs button{padding:12px 14px;font-size:14px;border-bottom:2px solid transparent;cursor:pointer}.billing-tabs button[aria-selected=true]{border-color:var(--color-ink)}.billing-list :global(li){display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;border-bottom:1px solid var(--color-line)}.billing-list :global(small){display:block;color:var(--color-faint);margin-top:5px}.billing-list :global(button),.billing-list :global(a){text-decoration:underline;text-underline-offset:4px;cursor:pointer}dialog::backdrop{background:#0005;backdrop-filter:blur(3px)}[data-run-content] :global(p){margin:12px 0;color:var(--color-soft);line-height:1.7;overflow-wrap:anywhere}[data-run-content] :global(h3){font-weight:600;margin-top:20px}[data-run-content] :global(pre){white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;margin-top:14px}[hidden]{display:none!important}</style>

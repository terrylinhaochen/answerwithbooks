---
import Base from '../layouts/Base.astro';
import AccountNav from '../components/AccountNav.astro';
---
<Base title="Your plan" description="Three free guides each month. Upgrade to thirty guides for $24/month." path="/billing/" robots="noindex, follow">
 <section class="awb-section py-10"><AccountNav /><p class="awb-eyebrow mt-8">Your plan</p><h1 class="font-serif text-4xl mt-3">Read around your questions.</h1>
 <p class="mt-4 text-soft">Start with 3 free guides every month. No card needed.</p>
 <div class="awb-panel mt-8 p-6 sm:p-8 max-w-2xl" data-reader-plan><h2 data-plan-price class="font-serif text-3xl">$24<span class="text-lg text-soft">/month</span></h2><p class="mt-4">Get up to 30 guides per month.</p><p class="mt-5" data-plan-usage></p><p class="mt-3 text-sm text-soft" data-plan-status role="status">Checking your plan…</p><div class="mt-6 flex flex-wrap gap-3"><a data-plan-free hidden href="/guides/" class="awb-pill awb-pill-primary">Create a free guide →</a><button type="button" data-plan-checkout class="awb-pill awb-pill-primary" disabled>Subscribe · $24/month</button><button type="button" data-plan-portal class="awb-pill" hidden>Manage subscription</button><a data-plan-login hidden href="/login/?next=%2Fbilling%2F" class="awb-pill">Sign in</a><button type="button" data-plan-refresh class="awb-pill">Refresh</button></div></div>
 </section>
</Base>
<script>
import {serviceCall} from '../lib/book-upload';import {supabase} from '../lib/supabase';
const root=document.querySelector('[data-reader-plan]')!,status=root.querySelector('[data-plan-status]')!,usage=root.querySelector('[data-plan-usage]')!,checkout=root.querySelector<HTMLButtonElement>('[data-plan-checkout]')!,portal=root.querySelector<HTMLButtonElement>('[data-plan-portal]')!,login=root.querySelector<HTMLElement>('[data-plan-login]')!,free=root.querySelector<HTMLElement>('[data-plan-free]')!;
async function refresh(){try{root.querySelector('[data-plan-price]')!.innerHTML='$24<span class="text-lg text-soft">/month</span>';const {data}=await supabase.auth.getSession();login.hidden=!!data.session;if(!data.session){free.hidden=false;checkout.hidden=true;portal.hidden=true;usage.textContent='';status.textContent='Sign in for 3 free guides each month.';return;}const plan=await serviceCall('reader-subscription',{action:'status'});if(plan.tier==='complimentary')root.querySelector('[data-plan-price]')!.textContent='Complimentary · $0';free.hidden=plan.active||plan.used>=plan.limit;checkout.hidden=plan.active;checkout.disabled=!plan.checkoutAvailable;portal.hidden=plan.status==='none'||!plan.checkoutAvailable;usage.textContent=`${Math.max(0,plan.limit-plan.used)} of ${plan.limit} ${plan.active?'':'free '}guides remaining`;status.textContent=plan.tier==='complimentary'?`Complimentary access · $0. Your monthly allowance resets ${new Date(plan.periodEnd).toLocaleDateString('en-US',{month:'long',day:'numeric',timeZone:'UTC'})} (UTC).`:plan.active?`${plan.cancelAtPeriodEnd?'Access ends':'Renews'} ${new Date(plan.periodEnd).toLocaleDateString()}.`:`Free guides reset ${new Date(plan.periodEnd).toLocaleDateString('en-US',{month:'long',day:'numeric',timeZone:'UTC'})} (UTC).${plan.checkoutAvailable?'':' Paid checkout is not available yet.'}`;}catch(e){status.textContent=e instanceof Error?e.message:'Please try again.';}}
for(const [button,action] of [[checkout,'checkout'],[portal,'portal']] as const)button.addEventListener('click',async()=>{button.disabled=true;try{const result=await serviceCall('reader-subscription',{action});const url=new URL(result.url);if(!['checkout.stripe.com','billing.stripe.com'].includes(url.hostname)||url.protocol!=='https:')throw Error('Invalid payment link');location.assign(url.href);}catch(e){status.textContent=e instanceof Error?e.message:'Please try again.';button.disabled=false;}});
root.querySelector('[data-plan-refresh]')!.addEventListener('click',refresh);
window.addEventListener('focus',refresh);supabase.auth.onAuthStateChange(()=>setTimeout(refresh,0));
if(new URLSearchParams(location.search).has('checkout')){let attempts=0;const poll=setInterval(()=>{void refresh();if(++attempts>=12)clearInterval(poll);},2500);window.addEventListener('pagehide',()=>clearInterval(poll),{once:true});}
void refresh();
</script>

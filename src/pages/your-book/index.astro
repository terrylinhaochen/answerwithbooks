---
import Base from '../../layouts/Base.astro';
import BookOverview from '../../components/BookOverview.astro';
import BookPurchase from '../../components/BookPurchase.astro';
import BookDigestPersonalizer from '../../components/BookDigestPersonalizer.astro';
import FaqList from '../../components/FaqList.astro';
const faqs=[{question:'What is this book useful for?',answer:'Its ideas can help you examine your question. The summary above explains its scope.'},{question:'How does Answer with Books use this book?',answer:'Your connected agent retrieves relevant methods and cited excerpts from your private library, then applies them to your task.'},{question:'Which answers draw on this book?',answer:'This is a private book. It is available to your connected agent and has not been added to the public answer catalog.'}];
---
<Base title="Your book" description="Your private book digest and connected agent skill." path="/your-book/" robots="noindex, nofollow">
 <article class="mx-auto max-w-5xl px-5 pt-16 pb-10" data-private-book>
  <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap justify-between gap-3 text-sm text-soft"><a href="/profile/" class="hover:text-accent">← Your library</a><a href="/manage-skills/" class="underline underline-offset-4">Manage Skills</a></nav>
  <p hidden class="mb-6 rounded-xl border border-line p-4 text-sm" data-job-archived>This book is archived and excluded from your agent’s library search. <a href="/manage-skills/?tab=archived" class="underline">Restore it in Manage Skills</a>.</p>
  <header class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,1fr)_minmax(13rem,18rem)] lg:items-start">
   <div><p class="awb-eyebrow" data-job-digest-meta>Private book digest</p><h1 class="mt-3 text-wrap break-words font-serif text-4xl leading-tight sm:text-5xl" data-job-title>Loading your book…</h1><p class="mt-3 text-soft" data-job-author></p><p class="mt-2 text-sm text-faint">Digest by Answer with Books</p><p hidden class="mt-3 text-sm text-soft" data-job-scope></p>
    <div hidden class="mt-5" data-job-header-actions><button class="awb-pill awb-pill-primary" data-job-copy>Copy prompt for your AI</button><p class="mt-3 text-sm text-soft" role="status" data-job-copy-status>Includes the digest and instructions. Paste into your AI chat and send.</p></div>
   </div>
   <div hidden data-job-cover class="w-24 sm:w-36 my-4 justify-self-start lg:justify-self-end" role="img" aria-label="Generated book cover"></div>
  </header>
  <BookOverview client />
  <section hidden data-job-content>
   <section data-reading-content class="mt-10 rounded-2xl border border-line bg-card px-5 py-6 sm:px-7 sm:py-8"><div class="prose-awb prose-awb--aligned" data-job-reading></div></section>
   <details hidden class="mt-8 rounded-2xl border border-line bg-card p-6" data-job-lessons><summary class="cursor-pointer font-serif text-2xl">Core lessons &amp; key frameworks</summary><div class="prose-awb mt-5" data-job-reference-notes></div></details>
   <BookPurchase client />
   <BookDigestPersonalizer client>
    <details class="mt-6 rounded-xl border border-line p-5" data-job-skill-card><summary class="cursor-pointer font-serif text-xl">Agent Skill Card</summary><p class="mt-4 leading-relaxed text-soft" data-job-skill-thesis></p><p class="mt-4 text-sm text-soft">Your connected agent finds the relevant methods and source excerpts when you ask it to use this book. No book download or separate installation is needed.</p><p class="mt-3 text-sm" data-job-skill-example></p><p hidden class="mt-4 text-sm text-soft" role="status" data-job-reader-notice></p></details>
   </BookDigestPersonalizer>
  </section>
  <section hidden data-job-management>
  <section class="mt-8 rounded-2xl border border-line p-5" aria-label="Processing progress"><p role="status" data-job-status>Checking your saved progress…</p><a hidden class="mt-3 block underline" data-job-existing-book></a><p hidden class="mt-3 text-sm text-soft" data-job-last-error></p><progress class="mt-4 w-full" data-job-progress max="100" value="0"></progress><p class="mt-3 text-sm text-soft" data-job-resume>Your upload is saved. Processing continues in the background; you can return to this link any time.</p><div class="mt-4 flex flex-wrap gap-3"><button hidden class="awb-pill" data-job-generate>Create summary and skill</button><button hidden class="awb-pill" data-job-retry>Resume processing</button><button hidden class="awb-pill" data-job-pause>Pause</button><button hidden class="awb-pill" data-job-cancel>Cancel conversion &amp; release funds</button><button hidden class="awb-pill" data-job-cover-retry>Retry cover</button><button hidden class="awb-pill" data-job-usage-show>View usage</button><a href="/processing/" class="awb-pill">View queue</a></div><p hidden class="mt-3 text-sm text-soft" data-job-usage></p></section>
  <section hidden class="mt-6 rounded-2xl border border-line p-5" data-job-payment><h2 class="font-serif text-2xl">Create this book and skill</h2><p class="mt-3 text-sm text-soft">Review the token rates and set a spending limit before starting. Generation, reviews, repairs and covers count toward your usage. Actual usage is charged even if processing fails or you cancel. Unused funds return to your balance. Missing usage is held for review. Reusing the result is free.</p><label class="mt-4 block text-sm">Maximum additional spend (USD)<input class="mt-2 block rounded border border-line p-2" data-job-limit type="number" min="0.01" max="1000" step="0.01" value="5.00" /></label><p class="mt-3 text-sm" role="status" data-job-price-message>Your source is saved. Review the spending limit before starting.</p><div class="mt-4 flex flex-wrap gap-3"><button type="button" class="awb-pill" data-job-quote>Review limit</button><button type="button" hidden class="awb-pill awb-pill-primary" data-job-pay></button><a href="/billing/" class="awb-pill" data-job-billing>Add funds / billing</a><a href="https://docs.answerwithbooks.com/guide/own-agent" class="awb-pill">Use my own agent</a></div></section>
  </section>
 </article>
 <div hidden data-private-faq><FaqList items={faqs} eyebrow="Book Q&A" title="How this book is used" width="medium" /></div>
 <script>import '../../lib/private-book';</script>
 <style>:global([data-job-cover]){perspective:900px}:global([data-job-cover] > .jacket){transform:rotateY(-18deg) rotateZ(-3deg)}progress{accent-color:var(--color-ink);height:6px;border:0;border-radius:8px;overflow:hidden}progress::-webkit-progress-bar{background:var(--color-line)}progress::-webkit-progress-value{background:var(--color-ink)}</style>
</Base>

---
import Base from '../layouts/Base.astro';
---
<Base title="Your profile" path="/my-books/" robots="noindex, follow">
  <section class="awb-section py-16"><h1 class="font-serif text-4xl">Your profile has moved.</h1><a class="awb-pill awb-pill-primary mt-6" href="/profile/">Open profile</a></section>
  <script>window.location.replace('/profile/' + window.location.search + window.location.hash);</script>
</Base>

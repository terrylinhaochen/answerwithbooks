---
import Base from '../layouts/Base.astro';
---
<Base title="Set or reset your password" description="Recover access to your Answer with Books account." path="/reset-password/" robots="noindex, nofollow">
 <section data-surface="auth" class="mx-auto max-w-sm px-5 pt-20 pb-24">
  <h1 class="font-serif text-3xl">Set or reset your password</h1>
  <p class="mt-3 text-soft">You can always sign in with an email link instead.</p>
  <form class="mt-8 space-y-5" data-recovery-request><label class="block text-sm">Account email<input class="awb-input mt-2" name="email" type="email" autocomplete="email" required /></label><button class="awb-pill awb-pill-primary" type="submit">Send recovery link</button></form>
  <form class="mt-8 space-y-5" data-recovery-update hidden><label class="block text-sm">New password<input class="awb-input mt-2" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label><button class="awb-pill awb-pill-primary" type="submit">Save password</button></form>
  <p class="mt-5 text-sm text-soft" role="status" data-recovery-status></p>
  <a href="/login/" class="mt-6 inline-block text-sm underline">Back to sign in</a>
 </section>
</Base>
<script>
 import {supabase} from '../lib/supabase';
 import {consumeAuthCallback,emailRedirectTo} from '../lib/auth-callback';
 const request=document.querySelector<HTMLFormElement>('[data-recovery-request]')!, update=document.querySelector<HTMLFormElement>('[data-recovery-update]')!, status=document.querySelector<HTMLElement>('[data-recovery-status]')!;
 let retryAt=0,busy=false;
 const showUpdate=()=>{request.hidden=true;update.hidden=false;};
 supabase.auth.onAuthStateChange(event=>{if(event==='PASSWORD_RECOVERY')showUpdate();});
 void consumeAuthCallback(supabase).then(async result=>{
  if(result.error){status.textContent='This link expired or was already used. Request another below.';return;}
  const session=result.session||(await supabase.auth.getSession()).data.session;
  if(session)showUpdate();
 });
 request.addEventListener('submit',async event=>{
  event.preventDefault();if(busy||Date.now()<retryAt||!request.reportValidity())return;
  busy=true;const button=request.querySelector<HTMLButtonElement>('button')!;button.disabled=true;
  try {const {error}=await supabase.auth.resetPasswordForEmail(String(new FormData(request).get('email')).trim(),{redirectTo:emailRedirectTo('/reset-password/')});
   status.textContent=error?.status===429?'Too many requests. Please wait a minute.':error&&error.status>=500?'Recovery is temporarily unavailable. Try again shortly.':'If this address has an account, a recovery link has been requested. Check your inbox and spam folder. Delivery may take a few minutes.';
  } catch {status.textContent='We could not confirm the request. Check your email before retrying.';}
  finally {busy=false;retryAt=Date.now()+60000;}
 });
 setInterval(()=>{if(busy)return;const seconds=Math.max(0,Math.ceil((retryAt-Date.now())/1000));const button=request.querySelector<HTMLButtonElement>('button')!;button.disabled=seconds>0;button.textContent=seconds?`Retry in ${seconds}s`:'Send recovery link';},1000);
 update.addEventListener('submit',async event=>{
  event.preventDefault();if(busy||!update.reportValidity())return;busy=true;const button=update.querySelector<HTMLButtonElement>('button')!;button.disabled=true;
  try {const {error}=await supabase.auth.updateUser({password:String(new FormData(update).get('password'))});if(error)throw error;update.reset();status.textContent='Password updated. You can now sign in with it.';}
  catch {status.textContent='We could not update your password. Request a fresh recovery link or use an email sign-in link.';}
  finally {busy=false;button.disabled=false;}
 });
</script>

---
import Base from '../layouts/Base.astro';
---

<Base
  title="Create an account"
  description="Create a free Answer with Books account to manage your preferences and connect your agent."
  path="/signup/"
  robots="noindex, follow"
>
  <section data-surface="auth" class="mx-auto max-w-sm px-5 pt-20 pb-24">
    <h1 class="font-serif text-3xl">Create an account</h1>
    <p class="mt-3 text-soft text-[0.95rem]" data-signup-copy>
      Save your shelf and turn your sources into books and skills. Newsletter subscription is a separate choice.
    </p>

    <form id="signup-form" class="mt-8 space-y-5">
      <div>
        <label for="email" class="block text-sm font-sans text-soft mb-1.5">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="awb-input"
        />
      </div>
      <div>
        <label for="password" class="block text-sm font-sans text-soft mb-1.5">
          Password <span class="text-faint">(8+ characters)</span>
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="awb-input"
        />
      </div>
      <p class="text-xs leading-relaxed text-soft">By creating an account, you agree to the <a href="/terms/" class="underline">Terms</a> and <a href="/privacy/" class="underline">Privacy Policy</a>. This does not subscribe you to the newsletter.</p>
      <p id="form-message" role="alert" aria-live="polite" class="text-sm hidden"></p>
      <button
        type="submit"
        id="submit-btn"
        class="awb-pill awb-pill-primary w-full cursor-pointer"
      >
        Create account
      </button>
    </form>
    <button type="button" data-resend-signup hidden class="mt-4 text-sm underline">Resend confirmation link</button>
    <p class="mt-3 text-xs text-soft" data-signup-delivery hidden>Check spam and confirm the address is correct. A successful request does not confirm inbox delivery. If a link does not arrive, try your primary address or <a href="mailto:terrychen2026@u.northwestern.edu?subject=Account%20verification" class="underline">contact support</a>.</p>

    <p class="mt-6 text-sm text-soft">
      Already have one?
      <a href="/login/" data-login-link class="text-accent underline underline-offset-4 decoration-1">Log in</a>.
    </p>
  </section>

  <script>
    import { supabase } from '../lib/supabase';
    import { consumeAuthCallback, emailRedirectTo } from '../lib/auth-callback';
    import { hasPendingOnboarding, persistOnboardingProfile } from '../lib/onboarding';

    const form = document.getElementById('signup-form') as HTMLFormElement;
    const message = document.getElementById('form-message') as HTMLParagraphElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const signupCopy = document.querySelector<HTMLElement>('[data-signup-copy]');
    const loginLink = document.querySelector<HTMLAnchorElement>('[data-login-link]');
    const from = new URLSearchParams(window.location.search).get('from');
    const fromOnboarding = from === 'onboarding';
    const fromUpload = from === 'upload';
    const pendingOnboarding = fromOnboarding || hasPendingOnboarding();
    const redirectAfterAuth = from === 'agent' ? '/connect-agent/' : from === 'shelf' ? '/?personalize=1' : pendingOnboarding ? '/profile/?onboarded=1' : fromUpload ? '/upload/' : '/my-books/';
    const authReturnPath = from === 'agent' ? '/auth/confirm/?from=agent' : from === 'shelf' ? '/auth/confirm/?from=shelf' : '/auth/confirm/';

    if (from === 'agent') {
      if (signupCopy) signupCopy.textContent = 'Create an account to connect your agent to your private books.';
      if (loginLink) loginLink.href = '/login/?from=agent';
    } else if (from === 'shelf') {
      if (signupCopy) signupCopy.textContent = 'Create an account to choose and save your own book collection.';
      if (loginLink) loginLink.href = '/login/?from=shelf';
    } else if (pendingOnboarding) {
      if (signupCopy) {
        signupCopy.textContent =
          'Your setup is saved in this browser. Create an account to sync it to your profile.';
      }
      if (loginLink) loginLink.href = '/login/?from=onboarding';
    } else if (fromUpload) {
      if (signupCopy) signupCopy.textContent = 'Create an account to map content to your personal shelf.';
      if (loginLink) loginLink.href = '/login/?from=upload';
    }

    const show = (text: string, kind: 'error' | 'ok') => {
      message.textContent = text;
      message.classList.remove('hidden', 'text-accent', 'text-soft');
      message.classList.add(kind === 'error' ? 'text-accent' : 'text-soft');
    };

    const finishAuth = async (session, error, silent = false) => {
      if (error || !session) {
        if (!silent) show(error ?? 'Email link did not return a session. Try logging in again.', 'error');
        return;
      }
      if (pendingOnboarding) await persistOnboardingProfile(supabase, session);
      window.location.href = redirectAfterAuth;
    };

    consumeAuthCallback(supabase).then(async (result) => {
      if (result.handled) {
        await finishAuth(result.session, result.error);
        return;
      }
      const { data } = await supabase.auth.getSession();
      await finishAuth(data.session, undefined, true);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity() || submitBtn.disabled) return;
      message.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating account…';

      const formData = new FormData(form);
      try {
      const { data, error } = await supabase.auth.signUp({
        email: String(formData.get('email')).trim(),
        password: String(formData.get('password')),
        options: { emailRedirectTo: emailRedirectTo(authReturnPath) },
      });

      if (error) {
        show('We could not complete the request. Check your details or sign in if you already have an account.', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create account';
        return;
      }

      if (data.session) {
        // Email confirmation disabled in this project: signed in immediately.
        await finishAuth(data.session);
      } else {
        // Email confirmation required.
        show(
          pendingOnboarding
            ? 'Almost there. Check your email for a confirmation link, then log in to sync your setup.'
            : 'Almost there. Check your email for a confirmation link, then log in.',
          'ok'
        );
        submitBtn.textContent = 'Account request accepted';
        document.querySelector<HTMLElement>('[data-signup-delivery]')!.hidden = false;
        resend.hidden = false; cooldown();
      }
      } catch { show('We could not confirm the account request. Check your inbox before retrying.', 'error'); submitBtn.disabled=false; submitBtn.textContent='Create account'; }
    });
    const resend = document.querySelector<HTMLButtonElement>('[data-resend-signup]')!;
    let retryAt = 0;
    function cooldown() { retryAt = Date.now()+60000; resend.disabled=true; }
    setInterval(() => { const seconds=Math.max(0,Math.ceil((retryAt-Date.now())/1000));resend.disabled=seconds>0;resend.textContent=seconds?`Resend in ${seconds}s`:'Resend confirmation link'; },1000);
    resend.addEventListener('click',async()=>{
      if(Date.now()<retryAt)return;cooldown();
      try { const {error}=await supabase.auth.resend({type:'signup',email:(form.elements.namedItem('email') as HTMLInputElement).value.trim(),options:{emailRedirectTo:emailRedirectTo(authReturnPath)}});
        show(error?'We could not resend the link. Wait a minute or contact support.':'If this address needs confirmation, a new link has been requested. Check your inbox and spam folder.',error?'error':'ok');
      } catch { show('We could not confirm the resend. Please wait before retrying.','error'); }
    });
  </script>
</Base>

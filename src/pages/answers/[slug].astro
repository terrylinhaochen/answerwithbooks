---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import ReadingPersonalizer from '../../components/ReadingPersonalizer.astro';
import { buildGuideReadingPrompt } from '../../lib/reading-handoff';
import AnswerCover from '../../components/AnswerCover.astro';
import AnswerRow from '../../components/AnswerRow.astro';
import BookCover from '../../components/BookCover.astro';
import ContentFeedback from '../../components/ContentFeedback.astro';
import FaqList from '../../components/FaqList.astro';
import { topicsForTags } from '../../lib/topics';
import { compactDescription, compactList, faqJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const answers = await getCollection('answers');
  return answers.map((answer) => ({ params: { slug: answer.id }, props: { answer } }));
}

const { answer } = Astro.props;
const { Content } = await render(answer);
const topics = topicsForTags(answer.data.tags);
const answerWordCount = String(answer.body ?? '')
  .replace(/---[\s\S]*?---/, '')
  .replace(/\[[^\]]+\]\([^)]+\)/g, ' ')
  .replace(/[#*_>`-]/g, ' ')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const seoDescription = compactDescription(answer.data.description);

const allBooks = await getCollection('books');
const sourceBooks = answer.data.books
  .map((slug) => allBooks.find((b) => b.id === slug))
  .filter((b) => b !== undefined);
const sourceBookTitles = sourceBooks.map((book) => book.data.title);
const bookTitleMap = new Map(allBooks.map((book) => [book.id, book.data.title]));
const allAnswers = await getCollection('answers');
const relatedAnswers = allAnswers
  .filter((candidate) => candidate.id !== answer.id)
  .map((candidate) => {
    const sharedBooks = candidate.data.books.filter((book) => answer.data.books.includes(book)).length;
    const sharedTags = candidate.data.tags.filter((tag) => answer.data.tags.includes(tag)).length;
    return { candidate, score: sharedBooks * 2 + sharedTags };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf())
  .slice(0, 3)
  .map(({ candidate }) => candidate);

const dateFmt = answer.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const url = `https://answerwithbooks.com/answers/${answer.id}/`;
const readingPrompt = buildGuideReadingPrompt({
  title: answer.data.question,
  url,
  guide: `# ${answer.data.question}\n\n## Decision rule\n${answer.data.description}\n\n${answer.body ?? ''}`,
  sourceBooks: sourceBooks.map(book => ({
    title: book.data.title,
    author: book.data.author,
    url: `https://answerwithbooks.com/books/${book.id}/`,
    digest: book.body ?? '',
  })),
});
const answerCoverPath = fileURLToPath(new URL(`../../../public/answer-covers/${answer.id}.jpg`, import.meta.url));
const answerImage = existsSync(answerCoverPath) ? `/answer-covers/${answer.id}.jpg` : '/og.svg';
const breadcrumbs = [
  { name: 'AWB', url: 'https://answerwithbooks.com/' },
  { name: 'Guides', url: 'https://answerwithbooks.com/guides/' },
  { name: answer.data.question, url },
];
const faqs = [
  {
    question: answer.data.question,
    answer: answer.data.description,
  },
  {
    question: 'Which books is this guide grounded in?',
    answer: `This guide draws on ${compactList(sourceBookTitles, 'the source shelf')} and links back to each source book for deeper reading.`,
  },
  {
    question: 'How do I make this guide personal?',
    answer:
      'Choose your preferred AI in Personalize, then copy the guide and open it. The full guide, source-book digests, and reading instructions are included; paste them into your AI to connect the ideas to context you have actually shared. No link access or skill installation is required.',
  },
];
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: answer.data.question,
    description: seoDescription,
    isPartOf: { '@id': 'https://answerwithbooks.com/#website' },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    primaryImageOfPage: { '@id': `${url}#primaryimage` },
  },
  {
    '@type': 'ImageObject',
    '@id': `${url}#primaryimage`,
    url: new URL(answerImage, 'https://answerwithbooks.com').href,
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    headline: answer.data.question,
    description: answer.data.description,
    datePublished: answer.data.date.toISOString(),
    dateModified: answer.data.date.toISOString(),
    image: new URL(answerImage, 'https://answerwithbooks.com').href,
    author: { '@type': 'Organization', '@id': 'https://answerwithbooks.com/#organization', name: 'AWB', url: 'https://answerwithbooks.com/' },
    publisher: { '@type': 'Organization', '@id': 'https://answerwithbooks.com/#organization', name: 'AWB', url: 'https://answerwithbooks.com/' },
    inLanguage: 'en',
    isAccessibleForFree: true,
    wordCount: answerWordCount,
    articleSection: answer.data.tags,
    keywords: answer.data.tags,
    about: sourceBooks.map((book) => ({
      '@type': 'Book',
      name: book.data.title,
      author: { '@type': 'Person', name: book.data.author },
      url: `https://answerwithbooks.com/books/${book.id}/`,
    })),
    url,
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  },
  {
    ...faqJsonLd(url, faqs),
  },
];
---

<Base
  title={answer.data.question}
  description={seoDescription}
  path={`/answers/${answer.id}/`}
  image={answerImage}
  imageAlt={`Answer card for ${answer.data.question}`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-5xl px-5 pt-16 pb-10">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-soft">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/guides/" class="hover:text-accent">Guides</a></li>
      </ol>
    </nav>

    <header class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,28rem)] lg:items-start">
      <div>
        <p class="awb-eyebrow">Guide</p>
        <h1 class="mt-3 text-wrap break-words font-serif text-4xl leading-tight sm:text-5xl">
          {answer.data.question}
        </h1>
        <p class="mt-4 text-sm text-faint">
          By <a href="/editorial/" class="underline decoration-line underline-offset-4 hover:text-ink">AWB</a>
          <span aria-hidden="true"> · </span>
          <time datetime={answer.data.date.toISOString()}>{dateFmt}</time>
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <div class="guide-actions" role="group" aria-label="Guide actions">
          <button
            type="button"
            data-save-answer={answer.id}
            class="guide-action" aria-label="Save this guide" aria-pressed="false" title="Save this guide"
          >
<svg class="bookmark-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17l-6-4-6 4V4Z" /></svg>
          </button>
          <a
            href={`/speed-read/?q=${encodeURIComponent(answer.data.question)}`}
            class="guide-action" aria-label="Speed read source books" title="Speed read source books"
          >
<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15" /><path d="m15 8 4 3-4 3V8Z" fill="currentColor" stroke-width="1" /></svg>
          </a>
          </div>
          {topics.map((topic) => (
            <a
              href={`/topics/${topic.slug}/`}
              class="inline-flex min-h-8 items-center rounded-full bg-wash px-3 py-1 text-xs text-soft font-sans hover:text-ink"
            >
              {topic.label}
            </a>
          ))}
        </div>
      </div>
      <AnswerCover answer={answer} class="lg:mt-1" priority />
    </header>

    <section class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]">
      <div class="awb-card-link p-6 text-[1rem] leading-relaxed">
        <h2 class="awb-eyebrow mb-3">
          Decision rule
        </h2>
        <p class="text-soft">{answer.data.description}</p>
      </div>

      <div class="awb-card-link p-5">
        <p class="awb-eyebrow">
          Source lens
        </p>
        <ul class="mt-4 space-y-4">
          {
            sourceBooks.map((book) => (
              <li class="flex items-center gap-4">
                <BookCover book={book} size="sm" />
                <div class="min-w-0">
                  <a
                    href={`/books/${book.id}/`}
                    class="font-serif text-xl leading-tight text-ink hover:text-accent"
                  >
                    {book.data.title}
                  </a>
                  <p class="mt-1 text-sm text-soft">{book.data.author}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section data-reading-content class="mt-10 rounded-2xl border border-line bg-card px-5 py-6 sm:px-7 sm:py-8">
      <div class="prose-awb prose-awb--aligned">
        <Content />
      </div>
    </section>

    <ReadingPersonalizer kind="guide" prompt={readingPrompt} />
  </article>

  <FaqList items={faqs} eyebrow="Guide Q&A" title="How to use this guide" width="medium" />

  <div class="mx-auto max-w-5xl px-5 pb-12">
    <ContentFeedback contentType="answer" contentSlug={answer.id} contentTitle={answer.data.question} />
  </div>

  {
    relatedAnswers.length > 0 && (
      <aside class="mx-auto max-w-5xl px-5 pb-16">
        <div class="border-t border-line pt-8">
          <h2 class="awb-eyebrow">
            Related guides
          </h2>
          <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {relatedAnswers.map((related) => (
              <AnswerRow answer={related} bookTitles={bookTitleMap} compact />
            ))}
          </div>
        </div>
      </aside>
    )
  }

  <script>
    import { SAVED_ANSWERS_KEY, readJson, toggleId } from '../../lib/user-library';

    const wireToggle = (selector: string, key: string, offText: string, onText: string) => {
      const button = document.querySelector<HTMLButtonElement>(selector);
      if (!button) return;
      const id = button.dataset.saveAnswer || button.dataset.likeAnswer;
      if (!id) return;

      const paint = () => {
        const active = readJson<string[]>(key, []).includes(id);
        const label = active ? onText : offText;
        button.setAttribute('aria-label', label);
        button.setAttribute('aria-pressed', String(active));
        button.title = label;
      };

      button.addEventListener('click', () => {
        toggleId(key, id);
        paint();
      });
      paint();
    };

    wireToggle('[data-save-answer]', SAVED_ANSWERS_KEY, 'Save this guide', 'Remove saved guide');
  </script>
  <style>
    .guide-actions { display:flex;align-items:center;gap:8px;padding-right:16px;border-right:1px solid var(--color-line) }
    .guide-action { display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;color:var(--color-ink);background:var(--color-card);border:1px solid var(--color-line);cursor:pointer;transition:background 150ms ease,border-color 150ms ease }
    .guide-action:hover { background:var(--color-wash);border-color:var(--color-ink) }
    .guide-action:focus-visible { outline:2px solid var(--color-ink);outline-offset:3px }
    .guide-action[aria-pressed=true] .bookmark-icon { fill:currentColor }
  </style>
</Base>

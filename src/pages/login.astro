---
import Base from '../layouts/Base.astro';
---

<Base
  title="Log in"
  description="Log in to AWB."
  path="/login/"
  robots="noindex, follow"
>
  <section class="mx-auto max-w-sm px-5 pt-20 pb-24">
    <h1 class="font-serif text-3xl">Log in</h1>
    <p class="mt-3 text-soft text-[0.95rem]" data-login-copy>
      Welcome back. Your <a href="/my-books/" class="text-accent underline underline-offset-4 decoration-1">saved books</a> are waiting.
    </p>

    <form id="login-form" method="post" class="mt-8 space-y-5">
      <div>
        <label for="email" class="block text-sm font-sans text-soft mb-1.5">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="awb-input"
        />
      </div>
      <div hidden data-password-field>
        <label for="password" class="block text-sm font-sans text-soft mb-1.5">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          disabled
          autocomplete="current-password"
          class="awb-input"
        />
      </div>
      <p id="form-message" role="alert" aria-live="polite" class="text-sm text-accent hidden"></p>
      <button
        type="submit"
        id="submit-btn"
        disabled
        class="awb-pill awb-pill-primary w-full cursor-pointer"
      >
        Send sign-in link
      </button>
    </form>
    <noscript><p class="mt-4 text-sm text-soft">Enable JavaScript to sign in securely.</p></noscript>
    <button type="button" data-login-mode class="mt-4 text-sm text-soft underline underline-offset-4 cursor-pointer">Use a password instead</button>

    <p class="mt-6 text-sm text-soft">
      No account yet?
      <a href="/newsletter/" data-signup-link class="text-accent underline underline-offset-4 decoration-1">Create one</a>.
    </p>
  </section>

  <script>
    import '../lib/login';
  </script>
</Base>

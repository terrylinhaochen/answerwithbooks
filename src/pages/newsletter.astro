---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---
<Base title="Practical AI for your team" description="A practical AI newsletter for non-technical teams: useful workflows, reusable prompts, and ideas from great books." path="/newsletter/">
  <section class="awb-section py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="font-sans text-sm font-semibold uppercase tracking-[0.08em] text-soft">AWB · Newsletter</p>
      <h1 class="mt-5 max-w-[15ch] font-serif text-5xl leading-[1.05] sm:text-7xl">A better way to use AI at work.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-soft">For teams in operations, marketing, sales, and beyond. Practical lessons you can use without a technical background.</p>
      <div class="mt-8"><NewsletterSignup /></div>
      <div class="mt-14 border-t border-line pt-8">
        <h2 class="font-serif text-3xl">One useful lesson. Each week.</h2>
        <p class="mt-4 text-lg leading-relaxed text-soft">A step-by-step workflow, a prompt to adapt, and an idea from a great book to help you make better decisions.</p>
        <ul class="mt-6 space-y-3 text-base leading-relaxed text-soft">
          <li>Turn meeting notes into an action plan with clear owners.</li>
          <li>Find patterns in customer feedback—and check the evidence.</li>
          <li>Draft a decision memo your team can actually use.</li>
        </ul>
        <a href="/guides/" class="mt-8 inline-block font-semibold underline underline-offset-4">Explore the guides</a>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import BookAdditions from '../components/BookAdditions.astro';
import ActivityPanel from '../components/ActivityPanel.astro';
import AccountNav from '../components/AccountNav.astro';

---

<Base
  title="Profile"
  description="Your account, reading activity, and preferences on AWB."
  path="/profile/"
  robots="noindex, follow"
>
  <section class="awb-section profile-page">
    <AccountNav active="profile" />
    <div id="library-loading" class="text-soft">Checking your session…</div>

    <div id="library-content" class="hidden">
      <header class="profile-header">
        <div>
          <p class="awb-eyebrow">Your account</p>
          <h1 class="profile-title">
            Welcome back<span id="user-name"></span>.
          </h1>
          <p id="profile-email" class="profile-email"></p>
        </div>
        <button type="button" id="signout-btn" class="profile-signout">Sign out</button>
      </header>

      <BookAdditions />

      <section id="preferences" class="profile-card profile-preferences">
        <div class="profile-card-heading"><h2>Your preferences</h2><a href="/onboarding/start/?from=profile">Edit preferences <span aria-hidden="true">→</span></a></div>
        <p id="profile-preferences" class="mt-3 text-soft">Choose the topics and questions you want to explore.</p>
      </section>
      <div class="profile-activity"><ActivityPanel eyebrow="Your activity" title="Keep your learning going." description="Your reading activity on this browser." showLink={false} showDetails={false} /></div>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';
    import { readOnboardingProfile, hasPendingOnboarding, persistOnboardingProfile } from '../lib/onboarding';

    const loading = document.getElementById('library-loading')!;
    const content = document.getElementById('library-content')!;
    const userName = document.getElementById('user-name')!;
    const signoutBtn = document.getElementById('signout-btn')!;

    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = '/login/';
    } else {
      const email = data.session.user.email ?? '';
      const metadata = data.session.user.user_metadata;
      const displayName = [metadata?.first_name, metadata?.full_name, metadata?.name].find(value => typeof value === 'string' && value.trim());
      const firstName = displayName ? displayName.trim().split(/\s+/)[0] : email.split('@')[0];
      userName.textContent = firstName ? `, ${firstName}` : '';

      loading.classList.add('hidden');
      content.classList.remove('hidden');
      document.getElementById('profile-email')!.textContent = email;
      const showPreferences = () => {
        const prefs = data.session.user.user_metadata?.answer_with_books_onboarding || readOnboardingProfile();
        if (!prefs) return;
        const focus = Array.isArray(prefs.focus) ? prefs.focus.filter(value => typeof value === 'string').join(', ') : '';
        document.getElementById('profile-preferences')!.textContent = [focus, typeof prefs.goal === 'string' ? prefs.goal : ''].filter(Boolean).join(' · ') || 'Choose the topics and questions you want to explore.';
      };
      showPreferences();
      if (hasPendingOnboarding()) void persistOnboardingProfile(supabase, data.session).then(showPreferences);


      signoutBtn.addEventListener('click', async () => {
        signoutBtn.setAttribute('disabled', '');
        const { error } = await supabase.auth.signOut();
        if (error) { signoutBtn.removeAttribute('disabled'); signoutBtn.textContent = 'Try signing out again'; return; }
        window.location.href = '/';
      });
    }
  </script>
</Base>
<style>
  .profile-page{padding-top:44px;padding-bottom:80px}.profile-header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:36px}.profile-header>div{min-width:0}.profile-title{margin-top:12px;font-family:var(--font-serif);font-size:clamp(30px,4vw,42px);line-height:1.2;overflow-wrap:anywhere}.profile-email{margin-top:12px;font-size:14px;color:var(--color-soft);overflow-wrap:anywhere}.profile-signout{font-size:13px;color:var(--color-soft);border:1px solid var(--color-line);padding:9px 15px;border-radius:8px;white-space:nowrap;cursor:pointer}.profile-signout:hover{color:var(--color-ink);background:var(--color-wash)}.profile-card{min-width:0;padding:24px;border:1px solid var(--color-line);border-radius:14px;background:var(--color-paper)}.profile-card-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.profile-card-heading h2{font-size:16px;font-weight:600}.profile-card-heading a{font-size:13px;color:var(--color-soft);display:inline-flex;align-items:center;gap:8px}.profile-card-heading a:hover{text-decoration:underline;text-underline-offset:4px}.profile-preferences,.profile-activity{margin-top:24px}.profile-signout:focus-visible{outline:2px solid var(--color-ink);outline-offset:4px}@media(max-width:640px){.profile-page{padding-top:28px}.profile-header{align-items:flex-start;gap:12px}.profile-title{font-size:30px}.profile-card{padding:20px}.profile-card-heading{flex-wrap:wrap;gap:8px}.profile-preferences,.profile-activity{margin-top:16px}}
</style>

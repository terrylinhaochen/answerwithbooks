---
import Base from '../layouts/Base.astro';
---
<Base title="Your processing queue" description="Follow your private books and skills as they are created." path="/processing/" robots="noindex, nofollow">
 <main class="mx-auto max-w-4xl px-5 py-16" data-book-queue>
  <a href="/profile/" class="text-sm underline">← Your profile</a>
  <p class="awb-eyebrow mt-8">Your sources</p><h1 class="mt-3 font-serif text-4xl">Books in the making.</h1>
  <p class="mt-4 text-soft">Each file becomes its own book and skill. Processing continues when you leave this page.</p>
  <p class="mt-5 text-sm text-soft" role="status" data-queue-message>Loading your queue…</p>
  <div class="mt-6 grid gap-4" data-queue-list></div>
 </main>
 <script>import '../lib/book-queue';</script>
</Base>

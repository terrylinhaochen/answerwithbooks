---
// Retain the shared entry-point contract used by the shelf and embedded upload.
interface Props { catalog?: unknown[]; title?: string; sourcePath?: string; bookBaseUrl?: string; }
---
<dialog id="book-upload-dialog" class="book-upload-dialog">
 <header class="flex items-center justify-between gap-4"><h2 class="font-serif text-3xl">Upload a source</h2><button type="button" data-close-book-upload aria-label="Close upload" class="p-3">×</button></header>
 <p class="mt-3 text-soft">Turn a book, research paper, or document into a readable artifact and a reusable skill.</p>
 <form class="mt-6">
  <label class="upload-drop"><span class="font-serif text-2xl">Choose a file</span><span class="mt-2 block text-sm text-soft">PDF · EPUB · DOCX · Markdown · HTML · RTF · Text</span><input class="mt-5 block w-full text-sm" type="file" accept=".pdf,.epub,.docx,.html,.htm,.xhtml,.rtf,.txt,.text,.md,.markdown,.rst,.adoc,.asciidoc" required aria-label="Source file" /></label>
  <p class="mt-3 text-sm text-soft">One file, up to 10 MB. PDFs need selectable text; scanned pages need OCR first.</p>
  <p class="mt-2 text-xs leading-relaxed text-soft">Private to your account. Source text is sent to our AI provider for processing.</p>
  <button type="submit" class="awb-pill awb-pill-primary mt-5" data-upload-submit>Create skill &amp; book</button>
  <p class="mt-4 text-sm text-soft" role="status" data-upload-status>Sign in to save your book. Three new books per day.</p>
  <a href="/login/" class="mt-3 inline-block underline" data-upload-login hidden>Sign in to Answer with Books</a>
 </form>
</dialog>
<style>
 .book-upload-dialog{margin:auto;width:min(560px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;border:1px solid var(--color-line);border-radius:24px;padding:28px;background:var(--color-card);color:var(--color-ink)}
 .book-upload-dialog::backdrop{background:#0006}.upload-drop{display:block;padding:24px;border:1px dashed var(--color-faint);border-radius:16px;background:var(--color-wash)}
</style>
<script>
 import {mountBookUpload} from '../lib/book-upload';
 mountBookUpload();
</script>

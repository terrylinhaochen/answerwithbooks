---
import uploadLimits from '../../supabase/functions/_shared/book-upload-limits.json';
// Retain the shared entry-point contract used by the shelf and embedded upload.
interface Props { catalog?: unknown[]; title?: string; sourcePath?: string; bookBaseUrl?: string; }
---
<dialog id="book-upload-dialog" class="book-upload-dialog">
 <header class="flex items-center justify-between gap-4"><h2 class="font-serif text-3xl">Upload a source</h2><button type="button" data-close-book-upload aria-label="Close upload" class="p-3">×</button></header>
 <p class="mt-3 text-soft">Turn a book, research paper, or document into a readable artifact and a reusable skill.</p>
 <form class="mt-6" novalidate>
  <label class="upload-drop" data-upload-drop>
   <svg class="upload-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg>
   <span class="font-serif text-2xl" data-upload-drop-title>Drop your file here</span>
   <span class="upload-browse">or choose a file</span>
   <span id="upload-formats" class="mt-4 block text-sm text-soft">PDF · EPUB · DOCX · Markdown · HTML · RTF · Text</span>
   <input class="sr-only" type="file" accept=".pdf,.epub,.docx,.html,.htm,.xhtml,.rtf,.txt,.text,.md,.markdown,.rst,.adoc,.asciidoc" required aria-label="Source file" aria-describedby="upload-formats upload-limits" />
  </label>
  <div class="upload-selection" data-upload-selection hidden><div><p data-upload-filename></p><p class="text-sm text-soft" data-upload-filesize></p></div><button type="button" data-upload-clear>Remove</button></div>
  <p id="upload-limits" class="mt-3 text-sm text-soft">One file, up to {uploadLimits.maxFileBytes / 1024 / 1024} MB. PDFs need selectable text; scanned pages need OCR first.</p>
  <p class="mt-2 text-xs leading-relaxed text-soft">Private to your account. Source text is sent to our AI provider for processing.</p>
  <button type="submit" class="awb-pill awb-pill-primary mt-5" data-upload-submit disabled>Create skill &amp; book</button>
  <p class="mt-4 text-sm text-soft" role="status" data-upload-status>Three new books per day.</p>
  <a href="/login/" class="mt-3 inline-block underline" data-upload-login hidden>Sign in to Answer with Books</a>
 </form>
</dialog>
<style>
 .book-upload-dialog{margin:auto;width:min(560px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;border:1px solid var(--color-line);border-radius:24px;padding:28px;background:var(--color-card);color:var(--color-ink)}
 .book-upload-dialog::backdrop{background:#0006}
 .upload-drop{display:flex;flex-direction:column;align-items:center;text-align:center;padding:26px 20px;border:1px dashed var(--color-faint);border-radius:16px;background:var(--color-wash);cursor:pointer;transition:border-color .15s,background .15s}
 .upload-icon{margin-bottom:14px;color:var(--color-soft)}
 .upload-browse{margin-top:6px;text-decoration:underline;text-underline-offset:4px;font-size:14px}
 .upload-drop:hover,.upload-drop.is-dragging{border-color:var(--color-ink);background:var(--color-card)}
 .upload-drop.is-dragging{outline:2px solid var(--color-ink);outline-offset:3px}
 .upload-drop:focus-within{outline:2px solid var(--color-ink);outline-offset:3px}
 .upload-drop[aria-disabled=true]{opacity:.6;cursor:progress}
 .upload-selection{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:14px;padding:14px 16px;border:1px solid var(--color-line);border-radius:12px}
 .upload-selection[hidden]{display:none}.upload-selection>div{min-width:0}
 [data-upload-filename]{overflow-wrap:anywhere;font-size:14px}
 [data-upload-clear]{flex-shrink:0;min-height:44px;text-decoration:underline;text-underline-offset:4px;font-size:13px;cursor:pointer}
 [data-upload-submit]:disabled{opacity:.5;cursor:not-allowed}
</style>
<script>
 import {mountBookUpload} from '../lib/book-upload';
 mountBookUpload();
</script>

---
import {getCollection} from 'astro:content';
import uploadLimits from '../../supabase/functions/_shared/book-upload-limits.json';
// Retain the shared entry-point contract used by the shelf and embedded upload.
interface Props { catalog?: unknown[]; title?: string; sourcePath?: string; bookBaseUrl?: string; }
const library=(await getCollection('books')).map(book=>({slug:book.id,title:book.data.title,author:book.data.author}));
---
<dialog id="book-upload-dialog" class="book-upload-dialog">
 <header class="flex items-center justify-between gap-4"><h2 class="font-serif text-3xl" data-upload-title>Upload sources</h2><button type="button" data-close-book-upload aria-label="Close upload" class="p-3">×</button></header>
 <p class="mt-3 text-soft" data-upload-intro>Get a readable book, a reusable skill, and a cover from each file.</p>
 <p class="mt-2 text-sm text-soft" data-upload-reuse-note>Already in your library? We’ll reuse it.</p>
 <script type="application/json" data-upload-library set:html={JSON.stringify(library).replace(/</g,'\\u003c')} />
 <form class="mt-6" novalidate>
  <label class="upload-drop" data-upload-drop>
   <svg class="upload-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg>
   <span class="font-serif text-2xl" data-upload-drop-title>Drop your files here</span>
   <span class="upload-browse">or choose files</span>
   <span id="upload-formats" class="mt-4 block text-sm text-soft">PDF, EPUB, DOCX, Kindle &amp; more</span>
   <input class="sr-only" type="file" multiple accept=".pdf,.epub,.mobi,.azw,.azw3,.docx,.html,.htm,.xhtml,.rtf,.txt,.text,.md,.markdown,.rst,.adoc,.asciidoc" required aria-label="Source file" aria-describedby="upload-formats upload-limits" />
  </label>
  <p id="upload-limits" data-upload-limits class="mt-3 text-sm text-soft">Up to ten files · {uploadLimits.maxFileBytes / 1024 / 1024} MB each.</p>
  <ul class="upload-files" data-upload-files aria-label="Selected sources"></ul>
  <button type="button" data-upload-clear hidden>Clear files</button>
  <details class="mt-4 upload-options"><summary class="cursor-pointer text-sm">Customize the result</summary>
   <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <label class="text-sm">Create<select name="mode" class="awb-input mt-1 w-full"><option value="full">Book, skill &amp; cover</option><option value="analysis">Analysis first</option></select></label>
    <label class="text-sm">Depth<select name="depth" class="awb-input mt-1 w-full"><option value="study">Study &amp; application</option><option value="reference">Quick reference</option></select></label>
    <label class="text-sm sm:col-span-2">Purpose<select name="purpose" class="awb-input mt-1 w-full"><option value="apply">Apply the methods</option><option value="mental-models">Learn mental models</option><option value="reference">Look up concepts</option><option value="all">All of the above</option></select></label>
   </div><p class="mt-2 text-xs text-soft">Analysis saves source-grounded notes. You can create the book and skill from those notes later.</p>
  </details>
  <details class="mt-3 upload-options"><summary class="cursor-pointer text-sm">File requirements</summary>
   <p class="mt-3 text-sm text-soft">PDF · EPUB · DOCX · MOBI · AZW · AZW3 · Markdown · HTML · RTF · Text</p>
   <p class="mt-2 text-sm text-soft">PDFs need selectable text; scanned pages need OCR first. Kindle files must be DRM-free. Long books are read in sections automatically.</p>
   <p class="mt-2 text-sm text-soft">Each file becomes a separate book and skill. Ten new sources per day.</p>
  </details>
  <p class="mt-5 text-xs leading-relaxed text-soft">Private to your account. Source text is sent to our AI provider for processing.</p>
  <button type="submit" class="awb-pill awb-pill-primary mt-5" data-upload-submit disabled>Create book &amp; skill</button>
  <p class="mt-4 text-sm text-soft" role="status" data-upload-status>We’ll choose how to read each file automatically.</p>
  <a href="/processing/" class="mt-3 inline-block underline" data-upload-queue hidden>View processing queue</a>
  <a href="/login/" class="mt-3 inline-block underline" data-upload-login hidden>Sign in to Answer with Books</a>
 </form>
</dialog>
<style>
 .book-upload-dialog{margin:auto;width:min(640px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;border:1px solid var(--color-line);border-radius:24px;padding:28px;background:var(--color-card);color:var(--color-ink)}
 .book-upload-dialog::backdrop{background:#0006}
 .upload-drop{display:flex;flex-direction:column;align-items:center;text-align:center;padding:26px 20px;border:1px dashed var(--color-faint);border-radius:16px;background:var(--color-wash);cursor:pointer;transition:border-color .15s,background .15s}
 .upload-icon{margin-bottom:14px;color:var(--color-soft)}
 .upload-browse{margin-top:6px;text-decoration:underline;text-underline-offset:4px;font-size:14px}
 .upload-drop:hover,.upload-drop.is-dragging{border-color:var(--color-ink);background:var(--color-card)}
 .upload-drop.is-dragging{outline:2px solid var(--color-ink);outline-offset:3px}
 .upload-drop:focus-within{outline:2px solid var(--color-ink);outline-offset:3px}
 .upload-drop[aria-disabled=true]{opacity:.6;cursor:progress}
 .upload-files{display:grid;gap:8px;margin-top:14px;max-height:250px;overflow:auto}
 .upload-files :global(li){display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--color-line);border-radius:12px;font-size:14px}
 .upload-files :global(li>div){min-width:0;overflow-wrap:anywhere}.upload-files :global(small){display:block;margin-top:4px;color:var(--color-soft);font-size:12px}
 .upload-files :global(button),[data-upload-clear]{flex-shrink:0;min-height:44px;text-decoration:underline;text-underline-offset:4px;font-size:13px;cursor:pointer}
 .upload-files :global(.upload-reuse){display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:6px}.upload-files :global(.upload-reuse a){font-size:13px}.upload-files :global(.upload-reuse button){text-align:left}
 .upload-files :global(a){text-decoration:underline;text-underline-offset:3px}
 [data-upload-submit]:disabled{opacity:.5;cursor:not-allowed}
</style>
<script>
 import {mountBookUpload} from '../lib/book-upload';
 mountBookUpload();
</script>

---
interface Props { title?: string; author?: string; client?: boolean; shared?: boolean; }
const { title='', author='', client=false, shared=false } = Astro.props;
---
<section id={client ? 'use-skill' : 'use-in-agent'} class="mt-8 rounded-2xl border border-line bg-card p-6" data-book-agent={client || undefined} data-private-agent={client || undefined} data-book-reading-cta={!client || undefined}>
 <h2 class="font-serif text-2xl">Put this book to work.</h2>
 {client ? <>
  <p class="mt-2 text-soft">Give your agent a way to approach your task: the book’s frameworks, practical rules, and limits. Ask it to draft a plan, review a decision, or improve your next interview.</p>
  <button type="button" class="awb-pill awb-pill-primary mt-5" data-copy-book-agent>Copy prompt for your AI</button>
  <p class="mt-3 text-sm text-soft" role="status" data-book-agent-status>Includes the book’s digest and instructions. Paste into your AI chat and send.</p>
  <textarea hidden readonly rows="10" class="awb-input mt-3 w-full" aria-label="Book agent prompt" data-book-agent-prompt></textarea>
 </> : <>
  <p class="mt-2 text-soft">Explore a question through original passages from this book. Add other books to create a reading around what matters to you.</p>
  <button type="button" class="awb-pill awb-pill-primary mt-5" data-find-excerpt data-shared-excerpt={shared || undefined} data-excerpt-title={title} data-excerpt-author={author} disabled={shared} aria-haspopup="dialog">Find an excerpt</button>
 </>}
 <slot />
</section>

<dialog id="book-preview" class="book-preview" aria-labelledby="book-preview-title">
 <div class="preview-shell">
  <button type="button" class="preview-close" data-preview-close autofocus>← Back to the books <span>Esc</span></button>
  <div class="preview-grid">
   <div class="preview-art"><div class="preview-jacket" data-preview-jacket></div><p>One book. A new perspective.</p></div>
   <div class="preview-copy">
    <p class="preview-category" data-preview-category></p><h2 id="book-preview-title"></h2><p class="preview-author" data-preview-author></p>
    <p class="preview-description" data-preview-description></p>
    <div class="preview-task"><p class="preview-category">Put it to work</p><h3 data-preview-task></h3></div>
    <div class="preview-actions"><a data-preview-link href="/books/">Open the book ↗</a><button type="button" data-preview-copy>Copy prompt for your AI</button></div>
    <p class="preview-status" data-preview-status role="status">Copies a link to this book and the Answer with Books skill.</p>
    <textarea data-preview-prompt hidden readonly aria-label="Prompt to copy"></textarea>
   </div>
  </div>
  <nav class="preview-navigation" aria-label="Browse books"><button type="button" data-preview-previous aria-label="Previous book">←</button><span data-preview-position></span><button type="button" data-preview-next aria-label="Next book">→</button></nav>
 </div>
</dialog>
<script>import '../lib/book-preview';</script>
<style>
.book-preview{width:min(1040px,calc(100vw - 40px));max-height:calc(100dvh - 40px);margin:auto;padding:0;border:1px solid #c8bfae;border-radius:3px;color:#282923;background:#f4f0e6 url('/print-study/paper.svg');overflow:auto;overscroll-behavior:contain;box-shadow:0 25px 100px #201b2540}
.book-preview::backdrop{background:#28251f88;backdrop-filter:blur(7px)}.preview-shell{padding:26px 36px}.preview-close{font-size:12px;display:flex;gap:14px;align-items:center;cursor:pointer}.preview-close span{font-size:9px;border:1px solid #bdb4a4;padding:2px 5px;border-radius:2px;color:#746d60}.preview-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:60px;align-items:center;padding:30px 20px}.preview-art{min-width:0;text-align:center}.preview-jacket{width:min(100%,260px);margin:auto}.preview-art>p{font-family:var(--font-serif);font-style:italic;color:#746e60;font-size:16px;margin-top:25px}.preview-category{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#655f53}.preview-copy h2{font-family:var(--font-serif);font-size:clamp(32px,4vw,52px);line-height:1.02;letter-spacing:-.035em;margin-top:13px}.preview-author{font-size:13px;color:#6d6659;margin-top:12px}.preview-description{font-size:14px;line-height:1.75;color:#655f53;margin-top:24px}.preview-task{margin-top:25px;padding-top:21px;border-top:1px solid #d3cbbb}.preview-task h3{font-family:var(--font-serif);font-size:24px;line-height:1.2;margin-top:8px}.preview-actions{display:flex;align-items:center;flex-wrap:wrap;gap:20px;margin-top:24px;font-size:12px}.preview-actions [data-preview-link]{display:inline-block;background:#2434ad;color:#faf6ec;border:0;padding:13px 18px;border-radius:2px;text-decoration:none}.preview-actions [data-preview-copy]{background:transparent;color:#655f53;border:0;padding:7px 0;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.preview-status{font-size:11px;line-height:1.65;color:#766f62;margin-top:14px}.preview-navigation{display:flex;align-items:center;justify-content:center;gap:22px;margin-top:12px;font-size:11px;color:#686252}.preview-navigation[hidden]{display:none}.preview-navigation button{width:38px;height:34px;font-size:20px;cursor:pointer}.preview-navigation button:hover{background:#e6dfd0}.book-preview :is(a,button,textarea):focus-visible{outline:2px solid #2434ad;outline-offset:4px}.preview-copy textarea{width:100%;min-height:120px;font-size:12px;line-height:1.6;border:1px solid #b9af9d;padding:10px;margin-top:15px}
@media(max-width:650px){.book-preview{width:calc(100vw - 24px);max-height:calc(100dvh - 24px)}.preview-shell{padding:20px}.preview-grid{grid-template-columns:1fr;gap:24px;padding:25px 0 12px}.preview-jacket{width:150px}.preview-art>p{font-size:14px;margin-top:15px}.preview-copy h2{font-size:34px}.preview-description{margin-top:18px}.preview-task{margin-top:19px;padding-top:16px}}
</style>

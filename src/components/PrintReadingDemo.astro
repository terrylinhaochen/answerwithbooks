---
import {skillDemoFlow as flow} from '../lib/skill-demo-flow';
import {printBooks} from '../lib/print-study.mjs';
import BookJacket from './BookJacket.astro';
---
<script is:inline>document.documentElement.classList.add('awb-demo-js');</script>
<section id="question-first-reading" class="home-section reading-demo" data-agent-demo data-demo-ui="reading" aria-labelledby="agent-demo-heading">
 <header class="reading-demo-heading"><div><p class="room-eyebrow">A question opens a book</p><h2 id="agent-demo-heading">Your agent, <em>well read.</em></h2></div><p>Your question.<br />A reading across lives.</p></header>
 <div class="reading-workspace" data-demo-window>
  <div class="reading-workspace-bar"><span class="agent-bar-title"><span class="agent-emblem" aria-hidden="true">✳</span>Your agent</span><span class="reading-progress" data-demo-run-state>Choosing books</span></div>
  <div class="reading-page" data-demo-scroll tabindex="0" role="region" aria-label="Scrollable agent conversation">
   <div class="reading-page-content" data-demo-conversation>
    <div class="agent-question" data-demo-reveal="0"><span class="conversation-person">You</span><div><p>{flow.question}</p><p class="question-context">{flow.context}</p></div></div>
    <div class="agent-response" data-demo-reveal="1"><span class="conversation-person"><span class="agent-emblem" aria-hidden="true">✳</span>Your agent</span><p>I’ll look for people who found their direction in different ways.</p><div class="agent-action" data-demo-tool="catalog"><span class="action-indicator" aria-hidden="true"></span><span>Exploring the library</span><span data-demo-catalog-label>3 books selected</span></div></div>
    <div class="agent-book-output" data-demo-reveal="2"><ul class="reading-book-selection">{flow.catalog.books.map((book,index)=><li><a href={`/books/read/?id=${printBooks[index].id}`} aria-label={`Read ${book.title}`}><span class="reading-book-cover"><BookJacket {...book} /></span><span class="reading-book-info"><span class="reading-book-name">{book.title}</span><span class="reading-book-author">{book.author}</span></span></a></li>)}</ul></div>
    <div class="agent-response" data-demo-reveal="3"><p>Now I’ll find passages that speak to your question—and connect them.</p><div class="agent-action" data-demo-tool="ask"><span class="action-indicator" aria-hidden="true"></span><span>Reading across three lives</span><span data-demo-call-label>Passages connected</span></div></div>
    <p class="agent-linkage" data-demo-reveal="4">Knight follows an attraction. Dyson stays with a problem. Agassi questions an ambition he inherited.</p>
    <article class="reading-result" data-demo-reveal="5" data-demo-reading aria-label="Example guide from original book passages">
     <p class="reading-label">Your reading · 01</p><h3>{flow.result}</h3>
     <p class="reading-prelude" data-demo-reveal="6">{flow.contextBefore}</p>
     <figure class="reading-passage" data-demo-reveal="7"><figcaption><span>From <em>Shoe Dog</em></span><span>Phil Knight · Dawn · p. 8</span></figcaption><blockquote>{flow.excerpt}</blockquote></figure>
     <p class="reading-reflection" data-demo-reveal="8">{flow.connection}</p>
     <div class="reading-next" data-demo-reveal="9"><span class="reading-label">The thread continues</span><p>{flow.note}</p><a class="reading-own-question" href="/guides/">Explore your own question <span aria-hidden="true">↗</span></a></div>
    </article>
   </div>
  </div>
  <div class="reading-workspace-foot"><span>Original words. New connections.</span><span>Scroll through the reading ↓</span></div>
 </div>
</section>
<style>
.reading-demo-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:32px}.reading-demo-heading h2{margin-top:12px}.reading-demo-heading>p{font-size:14px;line-height:1.7;color:var(--color-soft)}
.reading-workspace{background:#faf7ee;border:1px solid #cfc6b6;color:#39352f;box-shadow:0 10px 32px #443c2810;overflow:hidden}.reading-workspace-bar,.reading-workspace-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 28px;border-bottom:1px solid #dcd4c5;background:#f3eee2}.agent-bar-title{display:flex;align-items:center;gap:10px;font-size:13px}.agent-emblem{color:#8b4936;font-size:22px;line-height:1}.reading-progress{font-size:11px;color:#746f60}
.reading-page{height:590px;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#b9ae98 transparent}.reading-page-content{padding:30px 38px 40px;max-width:860px;margin:auto}.conversation-person{display:flex;align-items:center;gap:8px;font-size:11px;color:#796f61;margin-bottom:12px}.conversation-person .agent-emblem{font-size:18px}.agent-question{max-width:82%;margin:0 0 32px auto}.agent-question>.conversation-person{justify-content:flex-end}.agent-question>div{background:#ede5d6;padding:18px 22px;border-radius:12px 12px 2px 12px;border:1px solid #ded3bf}.agent-question>div>p:first-child{font-size:16px;line-height:1.5}.question-context{font-size:12px;line-height:1.65;color:#7b6f5c;margin-top:10px}.agent-response{margin-top:24px}.agent-response>p,.agent-linkage{font-size:14px;line-height:1.8;color:#665d51}.agent-action{display:flex;align-items:center;gap:10px;padding:14px 17px;margin:16px 0;background:#f1ecdf;border:1px solid #dfd6c5;border-radius:3px;font-size:12px;color:#665b4b}.agent-action>span:last-child{margin-left:auto;font-size:10px;color:#7c7667}.action-indicator{height:15px;width:15px;flex-shrink:0;border-radius:50%;background:#74846c;color:#fff;display:grid;place-items:center}.action-indicator::after{content:'✓';font-size:10px}.agent-action[data-loading=true] .action-indicator{background:transparent;border:1.5px solid #d4c6ae;border-top-color:#937451;animation:agent-working .9s linear infinite}.agent-action[data-loading=true] .action-indicator::after{content:''}.reading-demo[data-demo-paused=true] .action-indicator{animation-play-state:paused}.agent-linkage{padding-left:16px;border-left:2px solid #c4b395;margin:24px 0}
.reading-book-selection{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;list-style:none;padding:0;margin:0 0 28px}.reading-book-selection a{display:flex;align-items:center;gap:12px;padding:13px;background:#f4efe4;border:1px solid #e2d9c8;text-decoration:none;border-radius:3px}.reading-book-cover{display:block;width:54px;aspect-ratio:2/3;flex-shrink:0}.reading-book-name{display:block;font-size:12px;line-height:1.3}.reading-book-author{display:block;font-size:10px;line-height:1.4;color:#777063;margin-top:6px}.reading-book-info{min-width:0}.reading-label{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#80654e;line-height:1.5}
.reading-result{margin-top:28px;padding:28px 30px;background:#fffaf0;border:1px solid #d8cdbb;border-radius:3px}.reading-result h3{font-size:34px;line-height:1.12;letter-spacing:-.03em;margin:13px 0 22px}.reading-prelude,.reading-reflection,.reading-next p{font-size:13px;line-height:1.85;color:#6b6254}.reading-passage{margin:26px 0;border-block:1px solid #d8cdbb;padding:19px 0 24px}.reading-passage figcaption{display:flex;justify-content:space-between;flex-wrap:wrap;gap:5px;font-size:10px;color:#82705e}.reading-passage blockquote{font-family:var(--font-serif);font-size:25px;line-height:1.45;color:#403a30;margin:20px 0 0}.reading-next{margin-top:27px;padding-top:20px;border-top:1px solid #ded5c4}.reading-next p{margin-top:10px}.reading-own-question{display:inline-flex;gap:20px;font-size:12px;margin-top:22px;text-decoration:none;border-bottom:1px solid #b5a58d;padding-bottom:5px}.reading-workspace-foot{border-top:1px solid #dcd4c5;border-bottom:0;font-size:10px;color:#776d5e;padding:14px 28px}
:global(.awb-demo-js) .reading-demo [data-demo-reveal]:not([data-visible=true]){display:none}.reading-demo [data-demo-reveal][data-visible=true]{visibility:visible}.reading-demo :is(a,[tabindex]):focus-visible{outline:2px solid #8b4936;outline-offset:4px}@keyframes agent-working{to{transform:rotate(360deg)}}
@media(max-width:640px){.reading-demo-heading>p{display:none}.reading-page{height:540px;max-height:70svh}.reading-page-content{padding:24px 18px}.reading-workspace-bar{padding:17px 20px}.reading-progress{font-size:10px}.agent-question{max-width:94%}.agent-question>div{padding:15px 17px}.agent-question>div>p:first-child{font-size:14px}.agent-response>p,.agent-linkage{font-size:12px}.agent-action{padding:12px 10px;gap:8px;font-size:10px;flex-wrap:wrap}.agent-action>span:last-child{font-size:9px}.reading-book-selection{gap:7px}.reading-book-selection a{padding:10px 5px;flex-direction:column;gap:10px;text-align:center;align-items:center;height:100%}.reading-book-cover{width:51px}.reading-book-name{font-size:10px}.reading-book-author{font-size:9px}.reading-result{padding:23px 18px}.reading-result h3{font-size:28px}.reading-passage blockquote{font-size:22px}.reading-workspace-foot{padding:14px 20px;font-size:9px}.reading-workspace-foot>span:first-child{display:none}}
@media(prefers-reduced-motion:reduce){.reading-demo *{animation:none!important;transition:none!important}}
</style>

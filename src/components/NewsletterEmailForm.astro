---
import { newsletterSignupUrl } from '../lib/newsletter';
const id = `newsletter-${crypto.randomUUID()}`;
---
<div class="newsletter-email" data-newsletter-email>
  <form data-newsletter-email-form method="post" aria-label="Subscribe to AWB">
    <div class="newsletter-email__field">
      <label class="sr-only" for={id}>Email address</label>
      <input id={id} name="email" type="email" placeholder="Enter email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby={`${id}-consent ${id}-status`} />
      <button type="submit" disabled>Subscribe</button>
    </div>
    <div class="newsletter-email__trap" aria-hidden="true">
      <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p id={`${id}-consent`} class="newsletter-email__note">By subscribing, you sign up for an AWB account and newsletter and agree to our <a href="/terms/" target="_blank" rel="noopener noreferrer">Terms</a> and <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>. You can unsubscribe from the newsletter at any time.</p>
    <p id={`${id}-status`} class="newsletter-email__status" role="status" aria-live="polite" data-newsletter-status></p>
  </form>
  <p class="newsletter-email__note" data-account-login>Already have an account? <a href="/login/">Log in</a></p>
<section class="newsletter-account" hidden data-account-step>
  <h3 tabindex="-1" data-account-title>Check your email.</h3>
  <p data-account-copy></p>
  <div class="newsletter-account__actions"><button type="button" data-resend-verification>Resend verification email</button></div>
  <p class="newsletter-email__status" role="status" aria-live="polite" data-account-status></p>
  <button type="button" class="newsletter-account__reset" data-signup-reset>Use a different email</button>
</section>
  <noscript><p class="newsletter-email__note">Enable JavaScript to sign up here, or <a href={newsletterSignupUrl}>subscribe on Substack</a>.</p></noscript>
</div>
<style>
  .newsletter-email [hidden]{display:none!important}
  .newsletter-account{margin-top:20px;border-top:1px solid var(--color-line);padding-top:24px}
  .newsletter-account h3{font:500 30px/1.15 var(--font-serif);outline:none}
  .newsletter-account>[data-account-copy]{margin-top:12px;font:400 15px/1.6 var(--font-sans);color:var(--color-soft);overflow-wrap:anywhere}
  .newsletter-account__actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:20px}
  .newsletter-account__actions a{display:inline-flex;min-height:48px;align-items:center;padding:12px 24px;border-radius:999px;background:var(--color-ink);color:white;font:600 15px/1.4 var(--font-sans);text-decoration:none}
  .newsletter-account .newsletter-account__secondary{background:transparent;color:var(--color-soft);border:1px solid var(--color-line)}
  .newsletter-account .newsletter-account__reset{margin-top:14px;min-height:36px;padding:0;background:transparent;color:var(--color-soft);font-size:12px;text-decoration:underline;text-underline-offset:3px}
  .newsletter-email{width:100%;max-width:560px}
  .newsletter-email__field{display:flex;align-items:center;gap:8px;padding:7px;border:1px solid var(--color-line);border-radius:999px;background:#fff}
  .newsletter-email__field:focus-within{outline:2px solid var(--color-ink);outline-offset:3px}
  .newsletter-email input[type=email]{flex:1;min-width:0;width:100%;border:0;background:transparent;padding:12px 16px;font:400 16px/1.5 var(--font-sans);color:var(--color-ink);outline:none}
  .newsletter-email input::placeholder{color:var(--color-soft)}
  .newsletter-email button{flex-shrink:0;min-height:48px;padding:12px 24px;border-radius:999px;background:var(--color-ink);color:#fff;font:600 15px/1.4 var(--font-sans);cursor:pointer}
  .newsletter-email button:disabled{opacity:.6;cursor:default}
  .newsletter-email button:focus-visible{outline:2px solid var(--color-ink);outline-offset:3px}
  .newsletter-email__note,.newsletter-email__status{font:400 12px/1.6 var(--font-sans);color:var(--color-soft);margin:12px 0 0}
  .newsletter-email__status:empty{display:none}
  .newsletter-email__status[data-error=true]{color:#a12a20}
  .newsletter-email__trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .newsletter-email a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:480px){.newsletter-email button{padding:12px 18px}.newsletter-email input[type=email]{padding-left:10px}}
</style>
<script>
  import '../lib/newsletter-flow';
</script>

---
import {skillDemoFlow as flow} from '../lib/skill-demo-flow';
import BookJacket from './BookJacket.astro';
import {printGuideMarkup,printStudyEnabled} from '../lib/print-study.mjs';
import PrintReadingDemo from './PrintReadingDemo.astro';
const studyCover=printGuideMarkup(flow.question);
const catalogBooks=flow.catalog.books;
---
{printStudyEnabled ? <PrintReadingDemo /> : <>
<script is:inline>document.documentElement.classList.add("awb-demo-js");</script>
<section id="question-first-reading" class="home-section agent-demo" data-agent-demo aria-labelledby="agent-demo-heading">
 <header class="demo-heading"><div><p class="room-eyebrow">Skills in action</p><h2 id="agent-demo-heading">Your agent, <em>well read.</em></h2></div><p>Your question.<br />A reading across lives.</p></header>
 <div class="demo-window" data-demo-window>
  <div class="demo-titlebar"><div class="demo-agent-name"><span aria-hidden="true" class="demo-terminal-mark">&gt;_</span><span>Your agent</span></div></div>
  <div class="demo-scene" data-demo-scroll tabindex="0" role="region" aria-label="Scrollable reading demo">
   <div class="demo-conversation" data-demo-conversation aria-label="One illustrated great-work question">
    <div class="demo-user-message" data-demo-reveal="0"><span class="demo-speaker">You</span><p data-demo-words>{flow.question}<span class="demo-user-context">{flow.context}</span></p></div>
    <div class="demo-agent-message">
     <span class="demo-speaker" data-demo-reveal="1"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 5 5 5-5 5m8 0h5" /></svg>Your agent</span>
     <details class="demo-skill-call demo-catalog-call" data-demo-reveal="1" data-demo-tool="catalog">
      <summary><span class="demo-call-state" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 10 4 4 8-8" /></svg></span><code class="demo-call-action">books</code><span class="demo-call-book" data-demo-catalog-label>{flow.catalog.count} suggested books</span><svg class="demo-call-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></summary>
      <div class="demo-methods"><p>Explore the shared library.</p><pre><code>{flow.catalog.command}</code></pre><span>This illustrated reading brings together three lives.</span></div>
     </details>
     <ul class="demo-catalog" data-demo-reveal="2" aria-label="Three books in this illustrated reading">{catalogBooks.map(item=><li data-demo-choice={item.slug===flow.slug}><span class="demo-catalog-cover"><BookJacket title={item.title} author={item.author} slug={item.slug} color={item.color} loading="lazy" /></span><span class="demo-catalog-title">{item.title}</span></li>)}</ul>
     <details class="demo-skill-call" data-demo-reveal="3" data-demo-tool="ask">
      <summary><span class="demo-call-state" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 10 4 4 8-8" /></svg></span><code class="demo-call-action">ask</code><span class="demo-call-book" data-demo-call-label>{flow.matchedLabel}</span><svg class="demo-call-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></summary>
      <div class="demo-methods"><p>Ask with the task and context above</p><pre><code>{flow.command}</code></pre><p>Retrieved sources</p><ul>{flow.output.map(item=><li>{item}</li>)}</ul><span>The skill retrieves a guide and its source passages.</span></div>
     </details>
     <p class="demo-source-note" data-demo-reveal="4"><span aria-hidden="true">↳</span> {flow.sourceNote}</p>
     <article class="demo-answer" data-demo-reveal="5" aria-label="Excerpt from the illustrated guide">
      {studyCover && <div class="print-demo-cover" set:html={studyCover} />}
      <div><p class="demo-scene-label">{flow.scene}</p><h3 class="demo-answer-title">{flow.result}</h3></div>
      <p class="demo-reading-context" data-demo-reveal="6">{flow.contextBefore}</p>
      <figure class="demo-excerpt" data-demo-reveal="7"><span class="demo-excerpt-label">Original passage</span><blockquote>{flow.excerpt}</blockquote><figcaption>{flow.citation}</figcaption></figure>
      <p class="demo-connection" data-demo-reveal="8">{flow.connection}</p>
      <p class="demo-answer-note" data-demo-reveal="9">{flow.note}</p>
     </article>
    </div>
   </div>
  </div>
  <div class="demo-window-bottom"><span class="demo-context-dot" aria-hidden="true"></span><span>Scroll to explore the reading</span><span class="demo-run-state" data-demo-run-state>Ready to use</span></div>
 </div>
 <p class="sr-only" data-demo-announcement role="status" aria-live="polite"></p>
</section>
</>}
<style>
 .agent-demo{--demo-ink:#eeeee7;--demo-muted:#aaa9a0;--demo-accent:#d8bd88}
 .demo-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px}.demo-heading h2{margin-top:12px}.demo-heading>p{font-size:14px;line-height:1.7;color:var(--color-soft);padding-bottom:3px}
 .demo-window{color:var(--demo-ink);background:#20211f;border:1px solid #373831;border-radius:18px;overflow:hidden;box-shadow:0 3px 4px #24251a08,0 22px 60px -24px #222a2260}
 .demo-titlebar{height:62px;display:flex;align-items:center;gap:18px;padding:0 26px;border-bottom:1px solid #ffffff0d;background:#252623}
 .demo-agent-name{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:500}.demo-terminal-mark{font-family:monospace;font-size:18px;color:#d3d3c9;letter-spacing:-3px;line-height:1;width:23px}
 .demo-scene{height:520px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;scrollbar-color:#626957 #20211f;scrollbar-width:thin}
 .demo-conversation{padding:28px 32px;min-width:0;max-width:800px;margin:auto}.demo-speaker{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.015em;font-weight:500;color:#b7b9ad;margin-bottom:10px}.demo-user-message{margin:0 0 28px auto;max-width:92%;width:fit-content}.demo-user-message>.demo-speaker{justify-content:flex-end;color:#a7aa9d}.demo-user-message>p{background:#30312d;border:1px solid #ffffff08;border-radius:12px 12px 3px 12px;padding:13px 17px;font-size:14px;line-height:1.65;color:#edece4}
 .demo-agent-message{max-width:100%}.demo-agent-message>.demo-speaker{color:#d8d8cd}.demo-skill-call{background:#242620;border:1px solid #bec6a825;border-radius:7px;margin-top:12px;margin-bottom:23px;overflow:hidden}.demo-skill-call summary{display:flex;align-items:center;gap:10px;min-height:47px;padding:8px 13px;cursor:pointer;list-style:none;font-size:11px}.demo-skill-call summary::-webkit-details-marker{display:none}.demo-call-action{font-family:monospace;font-size:11px;color:#bbc7ad;white-space:nowrap}.demo-call-book{color:#c1c1b6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.demo-call-state{color:#b3c39e;display:grid;place-items:center;flex-shrink:0;width:17px;height:17px}.demo-call-chevron{margin-left:auto;flex-shrink:0;color:#9b9e8c;transition:transform .2s}.demo-skill-call[open] .demo-call-chevron{transform:rotate(90deg)}
 .demo-methods{padding:2px 16px 17px 40px;font-size:12px;line-height:1.8;color:#d1d4c5}.demo-methods>p{font-size:10px;color:#929985;margin-bottom:8px}.demo-methods ul{list-style:disc;padding-left:13px}.demo-methods pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#1b1c19;border:1px solid #ffffff10;padding:10px 12px;border-radius:5px;margin:0 0 15px;font-size:11px;line-height:1.8;color:#dddccf}.demo-methods code{font-family:monospace}.demo-methods>span{display:block;font-size:11px;color:#a8ae9c;margin-top:10px;line-height:1.7}
 .demo-user-context{display:block;font-size:11px;line-height:1.65;color:#b5b8a9;border-top:1px solid #ffffff10;margin-top:9px;padding-top:9px}
 .demo-catalog-call{margin-bottom:10px}.demo-catalog-cover{display:block;width:36px;height:54px;flex-shrink:0;perspective:500px}.demo-catalog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:19px}.demo-catalog li{display:flex;align-items:center;gap:8px;padding:9px;border:1px solid #ffffff0c;border-radius:5px;background:#24251f;color:#bbc0b0;font-size:11px;line-height:1.4;min-width:0;transition:border-color .4s,color .4s,background .4s}.demo-catalog span{min-width:0}.agent-demo[data-demo-matched=true] [data-demo-choice=true]{border-color:#d8bd8870;background:#d8bd880b;color:#ede2cc}
 .demo-source-note{display:flex;align-items:flex-start;gap:9px;font-size:11px;line-height:1.7;color:#afb99b;margin-top:-10px;margin-bottom:22px}.demo-source-note>span{font-family:monospace}
 .demo-answer{border:1px solid #ffffff19;border-radius:10px;background:#282a24;padding:24px}.demo-scene-label,.demo-excerpt-label{font-size:9px;text-transform:uppercase;letter-spacing:.13em;color:#c5b68e}.demo-answer-title{font-family:var(--font-serif);font-size:25px!important;line-height:1.2;font-weight:400;color:#f0eee4;margin:9px 0 14px}.demo-reading-context,.demo-connection{font-size:12px;line-height:1.8;color:#c5c8ba}.demo-excerpt{margin:20px 0;padding:18px 0 18px 18px;border-left:2px solid #bca678}.demo-excerpt blockquote{font-family:var(--font-serif);font-size:21px;line-height:1.5;color:#f0eee4;margin:9px 0 13px}.demo-excerpt figcaption{font-size:10px;color:#aaa995}.demo-answer-note{border-top:1px solid #ffffff12;padding-top:15px;margin-top:16px;font-size:11px;line-height:1.8;color:#b8b396}

 .demo-window-bottom{display:flex;gap:8px;align-items:center;min-height:42px;padding:10px 26px;border-top:1px solid #ffffff0b;background:#1d1e1b;font-size:10px;color:#a0a592}.demo-context-dot{width:4px;height:4px;border-radius:50%;background:#a4b392}.demo-run-state{margin-left:auto;color:#9ea18f}
 .agent-demo :is(button,a,summary):focus-visible{outline:2px solid var(--demo-accent);outline-offset:5px}.demo-skill-call summary:focus-visible{outline-offset:-3px}
 :global(.awb-demo-js) [data-demo-reveal]:not([data-visible=true]){display:none}[data-demo-reveal][data-visible=true]{visibility:visible}
 [data-demo-tool][data-loading=true] .demo-call-state svg{visibility:hidden}[data-demo-tool][data-loading=true] .demo-call-state{border:1.5px solid #bbc99e35;border-top-color:#cddaaa;border-radius:50%;width:13px;height:13px;margin-inline:2px;animation:demo-spin 1s linear infinite}

 [data-demo-paused=true] .demo-call-state{animation-play-state:paused!important}
 @keyframes demo-spin{to{transform:rotate(360deg)}}
 @media(max-width:900px){.demo-conversation{padding:28px}}
 @media(max-width:640px){.demo-heading{display:block;margin-bottom:25px}.demo-heading>p{display:none}.demo-heading h2{font-size:38px!important}.demo-titlebar{padding:0 17px;gap:10px;height:55px}.demo-scene{height:480px;max-height:65svh}.demo-conversation{padding:23px 21px 25px;min-height:0}.demo-user-message{margin-bottom:25px;max-width:96%}.demo-user-message>p{font-size:12px;padding:10px 13px;line-height:1.7}.demo-speaker{font-size:9px}.demo-skill-call{margin-bottom:22px}.demo-skill-call summary{gap:8px;padding:8px 11px;font-size:10px}.demo-call-action{font-size:10px}.demo-user-context{font-size:10px}.demo-source-note{font-size:10px}.demo-catalog{gap:6px;margin-bottom:17px}.demo-catalog li{padding:8px 5px;gap:7px;font-size:10px;flex-direction:column;text-align:center}.demo-catalog-cover{width:34px;height:51px}.demo-catalog-call{margin-bottom:10px}.demo-answer-title{font-size:16px}.demo-answer{padding:18px}.demo-excerpt blockquote{font-size:20px}.demo-answer-note{font-size:10px;margin-top:20px}.demo-window-bottom{padding:10px 17px;font-size:9px;gap:6px}.demo-run-state{display:none}.demo-methods{padding-left:33px}}
 @media(prefers-reduced-motion:reduce){.agent-demo *{animation:none!important;transition:none!important}}
</style>
<script>
 import {mountSkillDemo} from '../lib/skill-demo';
 mountSkillDemo();
</script>

---
import type { CollectionEntry } from 'astro:content';
import {skillDemoScenes} from '../lib/skill-demo-scenes';
interface Props { books: CollectionEntry<'books'>[]; }
const {books}=Astro.props;
const scenes=skillDemoScenes.map(scene=>{
 const book=books.find(book=>book.id===scene.slug);
 if(!book)throw new Error(`Missing skill demo book: ${scene.slug}`);
 return {...scene,title:book.data.title,author:book.data.author};
});
---
<section id="question-first-reading" class="home-section agent-demo" data-agent-demo aria-labelledby="agent-demo-heading">
 <header class="demo-heading"><div><p class="room-eyebrow">Skills in action</p><h2 id="agent-demo-heading">Your agent, <em>well read.</em></h2></div><p>A book’s methods.<br />At work in your next task.</p></header>
 <div class="demo-window" data-demo-window>
  <div class="demo-titlebar"><div class="demo-agent-name"><span aria-hidden="true" class="demo-terminal-mark">&gt;_</span><span>Your agent</span></div><span class="demo-example-label">Illustrated demo <span>· public book skill</span></span><button type="button" class="demo-playback" data-demo-playback aria-label="Replay demo" hidden><svg data-demo-playback-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1.7 7M4 4v6h6" /></svg><span data-demo-playback-label>Replay</span></button></div>
  <div class="demo-scenes">
  {scenes.map((scene,i)=><div id={`demo-scene-${i}`} class="demo-scene" data-demo-scene-panel={i} aria-label={scene.label} aria-hidden={i!==0} inert={i!==0} data-demo-active={i===0}>
   <aside class="demo-book" aria-label={`${scene.label}: ${scene.title}`}>
    <span class="demo-small-label">0{i+1} · {scene.label}</span>
    <a href={`/books/${scene.slug}/`} class="demo-book-object" aria-label={`Read ${scene.title}`}><img src={`/covers/${scene.slug}.jpg`} alt={`${scene.title} cover`} width="180" height="270" loading="lazy" /></a>
    <div class="demo-book-caption"><h3>{scene.title}</h3><p>{scene.author}</p></div>
    <div class="demo-skill-file"><svg width="14" height="16" viewBox="0 0 18 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M11 1H3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V6zM11 1v5h5M6 10h6M6 14h4" /></svg><span>SKILL.md</span><span class="demo-file-indicator" aria-hidden="true"></span></div>
   </aside>
   <div class="demo-conversation" aria-label={`${scene.label}: illustrated conversation`}>
    <div class="demo-user-message" data-demo-reveal="0"><span class="demo-speaker">You</span><p data-demo-words>{scene.task}{'context' in scene&&<span class="demo-user-context">{scene.context}</span>}</p></div>
    <div class="demo-agent-message">
     <span class="demo-speaker" data-demo-reveal="1"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 5 5 5-5 5m8 0h5" /></svg>Your agent</span>
     <details class="demo-skill-call" data-demo-reveal="1">
      <summary><span class="demo-call-state" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 10 4 4 8-8" /></svg></span><code class="demo-call-action">{scene.operation}</code><span class="demo-call-book" data-demo-call-label data-pending={scene.pending} data-returned={scene.returned}>{scene.returned}</span><svg class="demo-call-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></summary>
      <div class="demo-methods">
       {'setup' in scene&&<><p>Start the local API in another terminal</p><pre><code>{scene.setup}</code></pre></>}
       <p>Run the command</p><pre><code>{scene.command}</code></pre>
       <p>Retrieved sources</p><ul>{scene.output.map(item=><li>{item}</li>)}</ul>
       <span>{scene.outputNote}</span>
      </div>
     </details>
     <div class="demo-answer">
      <p class="demo-answer-title" data-demo-reveal="2">{scene.result}</p>
      {'picks' in scene?<ul class="demo-catalog">{scene.picks.map((book,index)=><li data-demo-reveal={index+3}><a href={`/books/${book.slug}/`}><img src={`/covers/${book.slug}.jpg`} alt="" width="24" height="36" loading="lazy" /><span><strong>{book.title}</strong><span>{book.use}</span></span><span aria-hidden="true">↗</span></a></li>)}</ul>:<ol>{scene.steps.map((step,index)=><li data-demo-reveal={index+3}><span aria-hidden="true">0{index+1}</span><p>{step}</p></li>)}</ol>}
      <p class="demo-answer-note" data-demo-reveal="6"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M10 3v8m0 3v2M3 2h14v16H3z" /></svg>{scene.note}</p>
     </div>
    </div>
   </div>
  </div>)}
  </div>
  <div class="demo-window-bottom"><span class="demo-context-dot" aria-hidden="true"></span><span>Sources from books. Applied by your agent.</span><span class="demo-run-state" data-demo-run-state>Example complete</span></div>
 </div>
 <footer class="demo-footer"><p>Install once. Bring the methods to your next task.</p><a class="room-link" href="/tools/">Explore skills <span aria-hidden="true">↗</span></a></footer>
 <p class="sr-only" data-demo-announcement role="status" aria-live="polite"></p>
</section>
<style>
 .agent-demo{--demo-ink:#eeeee7;--demo-muted:#aaa9a0;--demo-accent:#d8bd88}
 .demo-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px}.demo-heading h2{margin-top:12px}.demo-heading>p{font-size:14px;line-height:1.7;color:var(--color-soft);padding-bottom:3px}
 .demo-window{color:var(--demo-ink);background:#20211f;border:1px solid #373831;border-radius:18px;overflow:hidden;box-shadow:0 3px 4px #24251a08,0 22px 60px -24px #222a2260}
 .demo-titlebar{height:62px;display:flex;align-items:center;gap:18px;padding:0 26px;border-bottom:1px solid #ffffff0d;background:#252623}
 .demo-agent-name{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:500}.demo-terminal-mark{font-family:monospace;font-size:18px;color:#d3d3c9;letter-spacing:-3px;line-height:1;width:23px}
 .demo-example-label{margin-left:auto;font-size:11px;color:var(--demo-muted)}.demo-playback{display:flex;align-items:center;justify-content:center;gap:7px;font-size:11px;color:#d2d2c7;min-width:76px;min-height:44px;cursor:pointer;border-radius:6px}.demo-playback:hover{background:#ffffff0a}.demo-playback[hidden]{display:none}
 .demo-scenes{display:grid}
 .demo-scene{grid-area:1/1;display:grid;grid-template-columns:242px minmax(0,1fr);min-height:485px}.demo-scene[data-demo-active=false]{display:grid!important;visibility:hidden;pointer-events:none}.demo-scene[data-demo-active=false] *{visibility:hidden!important}
 .demo-book{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px 25px 35px;border-right:1px solid #ffffff0b;background:radial-gradient(ellipse at 50% 40%,#bdab7620,transparent 67%),#1b1c19;overflow:hidden}
 .demo-small-label{font-size:9px;text-transform:uppercase;letter-spacing:.16em;color:#b2b1a5;align-self:flex-start;margin-bottom:27px}
 .demo-book-object{position:relative;display:block;width:122px;transform:perspective(650px) rotateY(-13deg) rotateZ(-5deg);transform-style:preserve-3d;margin-right:8px;isolation:isolate;transition:transform .45s cubic-bezier(.2,.8,.2,1);flex-shrink:0}.demo-book-object:before{content:'';position:absolute;inset:3px -8px -3px 3px;z-index:-1;border-radius:2px 5px 5px 2px;background:linear-gradient(90deg,#b8b3a3,#f0eadd 78%,#a19b89);box-shadow:10px 16px 25px #0008}.demo-book-object:after{content:'';position:absolute;inset:0;border-radius:2px;background:linear-gradient(90deg,#0002,transparent 7%,#ffffff15 9%,transparent 14%);pointer-events:none}.demo-book-object img{display:block;width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;border-radius:2px 3px 3px 2px}.demo-book-object:hover{transform:perspective(650px) rotateY(-7deg) rotateZ(-2deg) translateY(-3px)}
 .demo-book-caption{text-align:center;margin-top:27px}.demo-book-caption h3{font-size:24px!important;line-height:1.12;letter-spacing:-.02em;color:#ece8db}.demo-book-caption p{font-size:11px;line-height:1.5;color:var(--demo-muted);margin-top:7px}
 .demo-skill-file{display:flex;align-items:center;gap:8px;border:1px solid #ffffff12;background:#ffffff03;padding:8px 10px;border-radius:5px;color:#c3c4b8;margin-top:22px;font-family:monospace;font-size:10px}.demo-file-indicator{width:5px;height:5px;border-radius:50%;background:#9caf8c;margin-left:6px}
 .demo-conversation{padding:31px 36px 30px;min-width:0}.demo-speaker{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.015em;font-weight:500;color:#b7b9ad;margin-bottom:10px}.demo-user-message{margin:0 0 28px auto;max-width:92%;width:fit-content}.demo-user-message>.demo-speaker{justify-content:flex-end;color:#a7aa9d}.demo-user-message>p{background:#30312d;border:1px solid #ffffff08;border-radius:12px 12px 3px 12px;padding:13px 17px;font-size:14px;line-height:1.65;color:#edece4}
 .demo-agent-message{max-width:640px}.demo-agent-message>.demo-speaker{color:#d8d8cd}.demo-skill-call{background:#242620;border:1px solid #bec6a825;border-radius:7px;margin-top:12px;margin-bottom:23px;overflow:hidden}.demo-skill-call summary{display:flex;align-items:center;gap:10px;min-height:47px;padding:8px 13px;cursor:pointer;list-style:none;font-size:11px}.demo-skill-call summary::-webkit-details-marker{display:none}.demo-call-action{font-family:monospace;font-size:11px;color:#bbc7ad;white-space:nowrap}.demo-call-book{color:#c1c1b6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.demo-call-state{color:#b3c39e;display:grid;place-items:center;flex-shrink:0;width:17px;height:17px}.demo-call-chevron{margin-left:auto;flex-shrink:0;color:#9b9e8c;transition:transform .2s}.demo-skill-call[open] .demo-call-chevron{transform:rotate(90deg)}
 .demo-methods{padding:2px 16px 17px 40px;font-size:12px;line-height:1.8;color:#d1d4c5}.demo-methods>p{font-size:10px;color:#929985;margin-bottom:8px}.demo-methods ul{list-style:disc;padding-left:13px}.demo-methods pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#1b1c19;border:1px solid #ffffff10;padding:10px 12px;border-radius:5px;margin:0 0 15px;font-size:11px;line-height:1.8;color:#dddccf}.demo-methods code{font-family:monospace}.demo-methods>span{display:block;font-size:11px;color:#a8ae9c;margin-top:10px;line-height:1.7}
 .demo-user-context{display:block;font-size:11px;line-height:1.65;color:#b5b8a9;border-top:1px solid #ffffff10;margin-top:9px;padding-top:9px}
 .demo-catalog{display:grid;gap:10px}.demo-catalog li>a{display:flex;align-items:center;gap:13px;width:100%;padding:2px 0;border-radius:4px}.demo-catalog img{width:24px;height:36px;object-fit:cover;border-radius:1px;box-shadow:2px 3px 5px #0005}.demo-catalog strong{display:block;font-size:13px;line-height:1.4;font-weight:500;color:#e0e1d4}.demo-catalog a>span>span{display:block;font-size:11px;line-height:1.7;color:#a9ae9d}.demo-catalog a>span:last-child{margin-left:auto;color:#a9ae9d;font-size:13px}.demo-catalog a:hover strong{color:#e6d0a4}
 .demo-answer-title{font-size:17px;line-height:1.5;font-weight:500;color:#f0eee4;margin-bottom:17px}.demo-answer ol{display:grid;gap:12px}.demo-answer li{display:flex;align-items:flex-start;gap:13px}.demo-answer li>span{font-family:monospace;color:#bbad8c;font-size:10px;line-height:2.3;flex-shrink:0}.demo-answer li>p{font-size:13px;line-height:1.8;color:#cdd0c1}.demo-answer-note{display:flex;gap:9px;align-items:flex-start;margin-top:22px;font-size:11px;line-height:1.7;color:#b8b396}.demo-answer-note svg{flex-shrink:0;margin-top:2px;color:#c7b686}
 .demo-window-bottom{display:flex;gap:8px;align-items:center;min-height:42px;padding:10px 26px;border-top:1px solid #ffffff0b;background:#1d1e1b;font-size:10px;color:#a0a592}.demo-context-dot{width:4px;height:4px;border-radius:50%;background:#a4b392}.demo-run-state{margin-left:auto;color:#9ea18f}
 .demo-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:24px}.demo-footer p{font-size:13px;color:var(--color-soft);line-height:1.6}.demo-footer a{font-size:13px;flex-shrink:0;min-height:44px;display:inline-flex;align-items:center;gap:16px}
 .agent-demo :is(button,a,summary):focus-visible{outline:2px solid var(--demo-accent);outline-offset:5px}.demo-skill-call summary:focus-visible{outline-offset:-3px}
 [data-demo-enhanced] [data-demo-reveal][data-visible=false]{visibility:hidden;opacity:0}[data-demo-enhanced] [data-demo-reveal][data-visible=true]{visibility:visible}
 [data-demo-phase=reading] .demo-scene[data-demo-active=true] .demo-call-state svg{visibility:hidden}[data-demo-phase=reading] .demo-scene[data-demo-active=true] .demo-call-state{border:1.5px solid #bbc99e35;border-top-color:#cddaaa;border-radius:50%;width:13px;height:13px;margin-inline:2px;animation:demo-spin 1s linear infinite}
 [data-demo-phase=reading] .demo-scene[data-demo-active=true] .demo-skill-file{border-color:#b6c68b80;color:#e0e8c9;background:#b6c68b09;transition:border-color .5s,color .5s}[data-demo-phase=reading] .demo-file-indicator{box-shadow:0 0 10px #b6c68b70}
 [data-demo-paused=true] .demo-call-state{animation-play-state:paused!important}
 @keyframes demo-spin{to{transform:rotate(360deg)}}
 @media(max-width:900px){.demo-scene{grid-template-columns:190px minmax(0,1fr)}.demo-conversation{padding:28px}.demo-book{padding-inline:20px}.demo-book-object{width:110px}.demo-book-caption h3{font-size:22px!important}}
 @media(max-width:640px){.demo-heading{display:block;margin-bottom:25px}.demo-heading>p{display:none}.demo-heading h2{font-size:38px!important}.demo-titlebar{padding:0 17px;gap:10px;height:55px}.demo-example-label{font-size:9px}.demo-example-label>span{display:none}.demo-playback{min-width:44px}.demo-playback>span{display:none}.demo-scene,.demo-scene[data-demo-active=false]{display:grid;grid-template-columns:1fr;grid-template-rows:max-content 1fr;min-height:0}.demo-book{display:grid;grid-template-columns:42px 1fr auto;grid-template-rows:auto auto;align-items:center;justify-content:initial;column-gap:15px;row-gap:4px;padding:19px 21px;border-right:0;border-bottom:1px solid #ffffff0b;background:radial-gradient(ellipse at 10% 50%,#bdab761a,transparent 60%),#1b1c19;overflow:visible}.demo-small-label{grid-column:2;grid-row:1;align-self:end;font-size:8px;margin:0}.demo-book-object{grid-column:1;grid-row:1/3;width:37px;margin:0;transform:perspective(600px) rotateY(-10deg) rotateZ(-5deg)}.demo-book-object:before{inset:1px -4px -1px 2px;box-shadow:4px 7px 10px #0007}.demo-book-caption{grid-column:2;grid-row:2;margin:0;text-align:left;align-self:start}.demo-book-caption h3{font-size:22px!important}.demo-book-caption p{display:none}.demo-skill-file{grid-column:3;grid-row:1/3;margin:0;padding:7px;font-size:8px;gap:5px}.demo-file-indicator{display:none}.demo-skill-file svg{width:11px}.demo-conversation{padding:23px 21px 25px;min-height:440px}.demo-user-message{margin-bottom:25px;max-width:96%}.demo-user-message>p{font-size:12px;padding:10px 13px;line-height:1.7}.demo-speaker{font-size:9px}.demo-skill-call{margin-bottom:22px}.demo-skill-call summary{gap:8px;padding:8px 11px;font-size:10px}.demo-call-action{font-size:10px}.demo-user-context{font-size:10px}.demo-catalog strong{font-size:12px}.demo-catalog a>span>span{font-size:10px}.demo-answer-title{font-size:16px}.demo-answer li>p{font-size:12px}.demo-answer li{gap:11px}.demo-answer ol{gap:11px}.demo-answer-note{font-size:10px;margin-top:20px}.demo-window-bottom{padding:10px 17px;font-size:9px;gap:6px}.demo-run-state{display:none}.demo-footer{align-items:flex-start;margin-top:19px;gap:15px}.demo-footer p{font-size:11px;max-width:23ch}.demo-footer a{font-size:11px;min-height:34px;gap:7px}.demo-methods{padding-left:33px}}
 @media(max-width:360px){.demo-book{grid-template-columns:42px minmax(0,1fr)}.demo-skill-file{display:none}}
 @media(prefers-reduced-motion:reduce){.agent-demo *{animation:none!important;transition:none!important}.demo-book-object:hover{transform:perspective(650px) rotateY(-13deg) rotateZ(-5deg)}}
</style>
<script>
 import {mountSkillDemo} from '../lib/skill-demo';
 mountSkillDemo();
</script>

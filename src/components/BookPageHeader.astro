---
import '../styles/book-cover.css';
interface Props {title?:string;author?:string;year?:number;words?:number;client?:boolean;}
const {title='Reading your book…',author='',year,words=0,client=false}=Astro.props;
---
<nav aria-label="Breadcrumb" class="mb-8 text-sm text-soft"><ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="hover:text-accent">Home</a></li><li aria-hidden="true">/</li><li><a href="/books/" class="hover:text-accent">Books</a></li></ol></nav>
<header class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,1fr)_minmax(13rem,18rem)] lg:items-start">
 <div>
  <p class="awb-eyebrow" data-book-meta={client||undefined}>{words?`Book digest · ${words.toLocaleString()} words · ${Math.max(1,Math.ceil(words/200))} min`:'Book digest'}</p>
  <h1 class="mt-3 text-wrap break-words font-serif text-4xl leading-tight sm:text-5xl" data-book-title={client||undefined}>{title}</h1>
  <p class="mt-3 text-soft" data-book-author={client||undefined}>{author}{year?`, ${year}`:''}</p>
  <p class="mt-2 text-sm text-faint">Digest by <a href="/editorial/" class="underline decoration-line underline-offset-4 hover:text-ink">Answer with Books</a></p>
  <slot name="actions" /><slot name="topics" />
 </div>
 <slot name="cover" />
</header>

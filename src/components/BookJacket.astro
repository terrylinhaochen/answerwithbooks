---
import {bookJacketMarkup} from '../lib/book-jacket.mjs';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
interface Props { title: string; author: string; slug: string; color: string; index?: number; loading?: 'eager' | 'lazy'; }
const { title, author, slug, color, loading = 'eager' } = Astro.props;
const extension = ['jpg', 'jpeg', 'png', 'svg'].find(ext =>
  existsSync(fileURLToPath(new URL(`../../public/covers/${slug}.${ext}`, import.meta.url)))
);
const coverAsset = extension ? `/covers/${slug}.${extension}` : undefined;
---
<Fragment set:html={bookJacketMarkup({title,author,color,coverAsset,loading})} />

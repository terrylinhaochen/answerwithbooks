---
import ToolCommand from './ToolCommand.astro';
import { bookSkillPlatforms } from '../lib/book-skill-install.mjs';
interface Props { id: string; }
const {id} = Astro.props;
const initial = bookSkillPlatforms[0];
---
<div class="skill-install-options" data-book-install-options>
 <label class="install-platform-label" for={id}>Choose your agent</label>
 <select id={id} data-book-install-agent disabled aria-describedby={`${id}-note`}>
  {bookSkillPlatforms.map(platform => <option value={platform.id}>{platform.name}</option>)}
 </select>
 <div class="install-terminal">
  <p class="install-terminal-label"><span aria-hidden="true">&gt;_</span> Run in your terminal <span>Node 20+</span></p>
  <ToolCommand value={initial.command} install label="Copy install command" />
 </div>
 <p id={`${id}-note`} class="install-caption" data-book-install-note>{initial.note}</p>
 <div class="install-first-task"><p data-book-install-next>{initial.next}</p><blockquote>“Use Answer with Books to help me choose work I can become great at.”</blockquote></div>
</div>
<style>
 .skill-install-options{margin-top:24px;min-width:0}
 .install-platform-label{display:block;font-size:12px;color:#626a59;margin-bottom:9px}
 select{appearance:auto;width:100%;min-height:44px;border:1px solid #c9cabb;border-radius:8px;background:#faf7ef;color:#35432e;padding:10px 12px;font:14px var(--font-sans);cursor:pointer}
 select:disabled{opacity:.6;cursor:default}select:focus-visible{outline:2px solid #62734e;outline-offset:3px}
 .install-terminal{margin-top:18px;border:1px solid #d8d5c9;border-radius:10px;background:#eeede3;padding:15px}
 .install-terminal>.install-terminal-label{display:flex;align-items:center;gap:9px;font-size:11px;color:#626a59;margin:0;line-height:1.6}.install-terminal-label>span:last-child{margin-left:auto;color:#7a806f;font-size:10px}
 .install-terminal :global(.tool-command__row){display:block;border:0;background:transparent;padding:4px 0 0}.install-terminal :global(pre){font-size:13px;color:#35432e;line-height:1.85}.install-terminal :global([data-copy-command]){display:block;width:100%;margin-top:16px;background:#354734;color:#f9f5e9;font-size:12px;font-weight:500;min-height:44px;border-radius:6px}.install-terminal :global([data-copy-command]:hover){background:#455a40}
 .skill-install-options>.install-caption{font-size:12px;line-height:1.7;margin-top:13px;color:#6b7263}
 .install-first-task{margin-top:24px;padding-top:20px;border-top:1px solid #d8d5c9}.install-first-task>p{font-size:11px;color:#747a6b;margin:0}.install-first-task blockquote{font-family:var(--font-serif);font-size:23px;line-height:1.25;letter-spacing:-.015em;margin-top:12px}
 @media(max-width:600px){.install-terminal{padding:13px}.install-terminal :global(pre){font-size:12px}}
</style>
<script>
 import {bookSkillPlatforms} from '../lib/book-skill-install.mjs';
 document.querySelectorAll<HTMLElement>('[data-book-install-options]').forEach(root=>{
  const select=root.querySelector<HTMLSelectElement>('[data-book-install-agent]')!;
  select.disabled=false;
  const update=()=>{
   const platform=bookSkillPlatforms.find(item=>item.id===select.value)||bookSkillPlatforms[0];
   root.querySelector('[data-command-text]')!.textContent=platform.command;
   root.querySelector('[data-book-install-note]')!.textContent=platform.note;
   root.querySelector('[data-book-install-next]')!.textContent=platform.next;
   root.querySelector('[data-copy-status]')!.textContent='';
   root.querySelector<HTMLElement>('[data-copy-fallback]')!.hidden=true;
   root.querySelector<HTMLTextAreaElement>('[data-copy-fallback] textarea')!.value='';
  };
  select.addEventListener('change',update);
  update(); // Match a browser-restored selection to its command.
 });
</script>

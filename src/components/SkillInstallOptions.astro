---
import ToolCommand from './ToolCommand.astro';
import { bookSkillPlatforms, bookSkillSetupPrompt } from '../lib/book-skill-install.mjs';
interface Props { id: string; }
const {id} = Astro.props;
const initial = bookSkillPlatforms[0];
---
<div class="skill-install-options" data-book-install-options>
 <header class="install-header"><h2 id={`${id}-title`} tabindex="-1">Set up your agent</h2></header>
 <div class="install-body">
  <section class="setup-step">
   <h3><span>1</span> Send this to your agent</h3>
   <ToolCommand value={bookSkillSetupPrompt} label="Copy setup message" />
   <p class="install-caption">Works with Codex, Claude Code, Cursor, and other agents that support local skills. Your agent handles the installation.</p>
  </section>
  <section class="setup-step">
   <h3><span>2</span> Connect your books</h3>
   <p class="install-caption">Public books work immediately. For your private library, ask your agent to connect Answer with Books and approve the sign-in in your browser. No API key needed.</p>
  </section>
  <section class="setup-step">
   <h3><span>3</span> Try it out</h3>
   <ToolCommand value="Use Answer with Books to help me understand organizational structure and division of labor." label="Copy example" />
  </section>
  <details class="terminal-setup" data-terminal-setup>
   <summary>Prefer the terminal?</summary>
   <label for={`${id}-platform`}>Your agent</label>
   <select id={`${id}-platform`} data-book-install-agent>
    {bookSkillPlatforms.map(platform => <option value={platform.id}>{platform.name}</option>)}
   </select>
   <div data-terminal-command><ToolCommand value={initial.command} install label="Copy command" /></div>
   <p class="install-caption" data-book-install-note>{initial.note} Requires Node 20 or later.</p>
  </details>
 </div>
</div>
<style>
 .skill-install-options{min-width:0;border:1px solid #d8d7d0;border-radius:14px;background:#fffefa;color:#35372f;overflow:hidden;margin-top:22px}
 .install-header{padding:26px 58px 23px 28px;border-bottom:1px solid #e4e1d9}
 .install-header h2{font-family:var(--font-sans);font-size:23px;font-weight:600;line-height:1.3;letter-spacing:-.025em;margin:0}
 .install-header h2:focus{outline:none}
 .install-body{padding:24px 28px 28px}
 .setup-step+.setup-step{margin-top:24px}
 .setup-step h3{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;margin:0}
 .setup-step h3 span{display:inline-grid;place-items:center;width:25px;height:25px;border:1px solid #d8ddce;border-radius:50%;color:#40523a;font-size:12px;flex:none}
 .install-caption{font-size:13px;line-height:1.7;margin:12px 0 0;color:#74776b}
 .install-body :global(.tool-command__row){background:#f1f1e9;border-color:#ddded2;border-radius:9px}
 .install-body :global(pre){font-size:13px;color:#35432e}
 .install-body :global([data-copy-command]){min-height:40px;color:#354734}
 .terminal-setup{margin-top:26px;border-top:1px solid #e4e1d9;padding-top:18px;font-size:13px}
 summary{cursor:pointer;font-weight:500;color:#666d5d}
 .terminal-setup label{display:block;margin:18px 0 6px}
 select{width:100%;min-height:42px;border:1px solid #ddded5;border-radius:7px;padding:8px;background:#fffefa}
 summary:focus-visible,select:focus-visible{outline:2px solid #40523a;outline-offset:3px}
 @media(max-width:560px){.install-header{padding:23px 52px 21px 20px}.install-header h2{font-size:21px}.install-body{padding:22px 20px}.install-body :global(.tool-command__row){flex-direction:column}.install-body :global([data-copy-command]){align-self:flex-end}.install-body :global(pre){font-size:12px}}
</style>
<script>
 import {bookSkillPlatforms} from '../lib/book-skill-install.mjs';
 document.querySelectorAll<HTMLElement>('[data-book-install-options]').forEach(root=>{
  const choice=root.querySelector<HTMLSelectElement>('[data-book-install-agent]')!;
  const terminal=root.querySelector<HTMLElement>('[data-terminal-command]')!;
  choice.addEventListener('change',()=>{
   const platform=bookSkillPlatforms.find(item=>item.id===choice.value)||bookSkillPlatforms[0];
   terminal.querySelector('[data-command-text]')!.textContent=platform.command;
   root.querySelector('[data-book-install-note]')!.textContent=platform.note+' Requires Node 20 or later.';
   terminal.querySelector('[data-copy-status]')!.textContent='';
   terminal.querySelector<HTMLElement>('[data-copy-fallback]')!.hidden=true;
   terminal.querySelector<HTMLTextAreaElement>('textarea')!.value='';
  });
  root.addEventListener('book-install-reset',()=>{
   root.querySelector<HTMLDetailsElement>('[data-terminal-setup]')!.open=false;
   root.querySelectorAll('[data-copy-status]').forEach(el=>el.textContent='');
   root.querySelectorAll<HTMLElement>('[data-copy-fallback]').forEach(el=>el.hidden=true);
  });
 });
</script>

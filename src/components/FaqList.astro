---
import QuestionDisclosure from './QuestionDisclosure.astro';
import type { FaqItem } from '../lib/seo';

interface Props {
  items: FaqItem[];
  eyebrow?: string;
  title?: string;
  width?: 'article' | 'medium' | 'wide';
  contained?: boolean;
}

const {
  items,
  eyebrow = 'Questions answered',
  title = 'Quick Q&A',
  width = 'article',
  contained = false,
} = Astro.props;

const widthClass =
  width === 'wide' ? 'max-w-6xl' : width === 'medium' ? 'max-w-5xl' : 'max-w-3xl';
---

{
  items.length > 0 && (
    <section class={`mx-auto ${widthClass} ${contained ? '' : 'px-5'} py-12`}>
      <div class="border-t border-line pt-8">
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-faint font-sans">{eyebrow}</p>
        <h2 class="mt-3 font-serif text-3xl">{title}</h2>
        <div class="mt-6 grid gap-3">
          {items.map((item) => (
            <QuestionDisclosure question={item.question} answer={item.answer} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

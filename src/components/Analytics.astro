---
interface Props { ids: string[]; }
const { ids } = Astro.props;
---
<script is:inline define:vars={{ ids }}>
  (() => {
    const key = 'awb:analytics-consent:v1';
    const maxAge = 180 * 24 * 60 * 60 * 1000;
    const blocked = navigator.globalPrivacyControl === true || navigator.doNotTrack === '1';
    const privateRoute = /^\/(login|signup|auth|reset-password|profile|my-books|your-book|processing|connect-agent|billing|api-keys|onboarding|upload|ask|embed|acquired-intelligence|community)(\/|$)/.test(location.pathname);
    let choice = null;
    let loaded = false;
    try {
      const stored = JSON.parse(localStorage.getItem(key) || 'null');
      if (['on', 'off'].includes(stored?.value) && Number.isFinite(stored.at) && stored.at <= Date.now() && Date.now() - stored.at < maxAge) choice = stored.value;
    } catch { /* No storage or invalid preference: analytics stays off. */ }
    if (blocked) choice = 'off';
    const disable = () => ids.forEach(id => { window[`ga-disable-${id}`] = true; });
    const clearAnalyticsCookies = () => {
      const labels = location.hostname.split('.');
      const domains = ['', ...labels.map((_, i) => `; domain=${labels.slice(i).join('.')}`)];
      for (const part of document.cookie.split(';')) {
        const name = part.trim().split('=')[0];
        if (!/^_ga(?:_|$)|^_gid$|^_gat(?:_|$)/.test(name)) continue;
        domains.forEach(domain => { document.cookie = `${name}=; Max-Age=0; path=/${domain}; SameSite=Lax`; });
      }
    };
    // Google's basic consent mode: no Google Analytics requests until a visitor opts in.
    window.dataLayer = window.dataLayer || [];
    const gtag = function () { window.dataLayer.push(arguments); };
    window.gtag = gtag;
    const denied = { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };
    gtag('consent', 'default', denied);
    const load = () => {
      // Account, submitted-content, and auth routes never initialize analytics.
      if (loaded || blocked || choice !== 'on' || !ids.length || privateRoute) return;
      loaded = true;
      ids.forEach(id => { window[`ga-disable-${id}`] = false; });
      gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag('js', new Date());
      ids.forEach(id => gtag('config', id, {
        allow_google_signals: false, allow_ad_personalization_signals: false,
        page_location: location.origin + location.pathname, page_referrer: '',
        cookie_expires: 15552000, send_page_view: true,
      }));
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ids[0])}`;
      script.dataset.awbAnalytics = '';
      document.head.appendChild(script);
    };
    const render = () => {
      document.querySelectorAll('[data-analytics-notice]').forEach(node => {
        node.hidden = choice !== null || blocked || privateRoute || !ids.length || /^\/privacy(\/|$)/.test(location.pathname);
      });
      document.querySelectorAll('[data-analytics-status]').forEach(node => {
        node.textContent = blocked ? 'Analytics is off because your browser requests no tracking.' : `Optional analytics is ${choice === 'on' ? 'on' : 'off'}. This choice applies to this browser.`;
      });
      document.querySelectorAll('[data-analytics-choice]').forEach(button => {
        button.disabled = blocked && button.dataset.analyticsChoice === 'on';
        button.setAttribute('aria-pressed', String(button.dataset.analyticsChoice === choice));
      });
    };
    disable();
    if (choice !== 'on') clearAnalyticsCookies();
    load();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', render);
    else render();
    const trackBookPurchaseClick = (event) => {
      if (event.type === 'auxclick' && event.button !== 1) return;
      if (event.type === 'click' && event.button !== 0) return;
      if (!loaded || choice !== 'on' || blocked || typeof window.gtag !== 'function') return;
      const link = event.target.closest?.('a[data-book-purchase]');
      if (!link) return;
      const asin = link.dataset.amazonAsin || '';
      const slug = link.dataset.bookSlug || '';
      if (!/^[A-Z0-9]{10}$/.test(asin) || !/^[a-z0-9-]+$/.test(slug)) return;
      const destination = new URL(link.href);
      if (destination.origin !== 'https://www.amazon.com' || destination.pathname !== `/dp/${asin}`) return;
      // A real outbound link works without analytics; never wait or prevent navigation.
      try {
        window.gtag('event', 'book_purchase_click', {
          book_slug: slug,
          retailer: 'amazon',
          marketplace: 'US',
          placement: link.dataset.purchasePlacement || 'digest_end',
          product_id: asin,
          link_url: `https://www.amazon.com/dp/${asin}`,
          transport_type: 'beacon',
        });
      } catch { /* Analytics must never interfere with opening the book. */ }
    };
    document.addEventListener('click', trackBookPurchaseClick);
    document.addEventListener('auxclick', trackBookPurchaseClick);
    document.addEventListener('click', event => {
      const button = event.target.closest?.('[data-analytics-choice]');
      if (!button || (blocked && button.dataset.analyticsChoice === 'on')) return;
      choice = button.dataset.analyticsChoice === 'on' ? 'on' : 'off';
      try { localStorage.setItem(key, JSON.stringify({ value: choice, at: Date.now() })); } catch { /* Applies to this page only. */ }
      if (choice === 'off') {
        disable(); gtag('consent', 'update', denied); clearAnalyticsCookies(); render();
        // Unload listeners installed by the third-party library after withdrawal.
        if (loaded) location.reload();
      } else { load(); render(); }
    });
    window.addEventListener('storage', event => {
      if (event.key === key || event.key === null) { disable(); location.reload(); }
    });
  })();
</script>

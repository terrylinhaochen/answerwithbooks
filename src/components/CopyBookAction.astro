---
import type { CollectionEntry } from 'astro:content';
interface Props { book?: CollectionEntry<'books'>; readingLink?: boolean; client?: boolean; }
const { book, readingLink = false, client = false } = Astro.props;
---
<div id="use-with-ai" class="copy-book-action" data-public-book-action>
 <div class="copy-book-actions"><button type="button" class="awb-pill awb-pill-primary" data-find-excerpt data-shared-excerpt={client||undefined} disabled={client} data-excerpt-title={book?.data.title} data-excerpt-author={book?.data.author} aria-haspopup="dialog">Find an excerpt</button>{readingLink && book && <a href={`/books/${book.id}/`}>Open the book</a>}</div>
 <p class="copy-book-status">Explore a question through this book’s original passages.</p>
</div>
<style>
 .copy-book-action { position: relative; z-index: 2; margin-top: 20px; scroll-margin-top: 100px; }
 .copy-book-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 13px 18px; }
 .copy-book-actions button { gap: 12px; cursor: pointer; white-space: nowrap; }
 .copy-book-actions a { font-size: 11px; text-underline-offset: 4px; }
 .copy-book-actions a:hover { text-decoration: underline; }
 .copy-book-status { font-size: 11px; line-height: 1.65; color: var(--color-soft); }
 .copy-book-status:not(:empty) { margin-top: 10px; }
 textarea:not([hidden]) { margin-top: 12px; }
</style>

---
interface Props { active: 'profile' | 'billing' | 'keys' }
const { active } = Astro.props;
const sections = [
  { id: 'profile', label: 'Profile', href: '/profile/', icon: 'M20 21v-2a7 7 0 0 0-14 0v2M17 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { id: 'billing', label: 'Billing', href: '/billing/', icon: 'M3 9h18M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM7 15h3' },
  { id: 'keys', label: 'API keys', href: '/api-keys/', icon: 'M15 7h.01M21 7a5 5 0 0 1-7 4.6L6 20H3v-3l8.4-8A5 5 0 1 1 21 7Z' },
];
---
<nav class="account-nav" aria-label="Your account">
  {sections.map(section => <a href={section.href} aria-current={active === section.id ? 'page' : undefined}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={section.icon} /></svg>{section.label}</a>)}
</nav>
<style>
  .account-nav{display:flex;gap:30px;border-bottom:1px solid var(--color-line);margin-bottom:36px}.account-nav a{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 2px 17px;border-bottom:2px solid transparent;margin-bottom:-1px;color:var(--color-soft);font-size:14px;font-weight:500;text-decoration:none}.account-nav a[aria-current=page]{border-bottom-color:var(--color-ink);color:var(--color-ink)}.account-nav a:hover{color:var(--color-ink)}.account-nav a:focus-visible{outline:2px solid var(--color-ink);outline-offset:4px}.account-nav svg{flex:none}@media(max-width:480px){.account-nav{gap:0;margin-bottom:28px}.account-nav a{flex:1;font-size:13px;gap:7px}}
</style>

---
import BrandMark from './BrandMark.astro';
const groups=[
 {title:'Explore',links:[['Books','/books/'],['Guides','/guides/'],['Skills','/tools/'],['Profile','/profile/']]},
 {title:'Help & legal',links:[['Help','https://docs.answerwithbooks.com/guide/troubleshooting'],['Terms','/terms/'],['Privacy','/privacy/']]},
];
---
<footer class="print-footer" id="site-footer">
 <div class="print-footer-inner">
  <div class="print-footer-opening"><a href="/" class="print-footer-brand"><BrandMark /><span>Answer with Books</span></a><p>There’s always <br /><em>another life to learn from.</em></p></div>
  <nav class="print-footer-links" aria-label="Footer">{groups.map(group=><div><h2>{group.title}</h2><ul>{group.links.map(([label,href])=><li><a href={href}>{label}</a></li>)}</ul></div>)}</nav>
 </div>
 <figure class="print-footer-view"><img src="/print-study/fort-mason-dissolve-v4.png" width="2172" height="724" loading="lazy" decoding="async" alt="Textured illustration of Fort Mason’s waterfront warehouses and wooded bluff." /></figure>
 <div class="print-footer-bottom"><span>© {new Date().getFullYear()} Answer with Books</span><a href="/privacy/#privacy-choices">Privacy choices</a><a href="#top">Back to top ↑</a></div>
</footer>
<style>
.print-footer-brand{display:inline-flex;align-items:center;gap:10px}
.print-footer{position:relative;overflow:hidden;background:var(--color-paper) url('/print-study/paper-soft.svg');color:var(--color-ink);border-top:1px solid var(--color-line);padding-top:70px}.print-footer-inner{max-width:1120px;padding:0 32px;margin:auto;display:grid;grid-template-columns:1.1fr 1.6fr;gap:80px;position:relative;z-index:1}.print-footer-brand{font-family:var(--font-serif);font-size:24px;letter-spacing:-.03em}.print-footer-opening p{font-family:var(--font-serif);font-size:34px;line-height:1.15;letter-spacing:-.025em;margin-top:30px;max-width:330px}.print-footer-opening em{font-weight:400;color:var(--color-accent)}.print-footer-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.print-footer-links h2{font-family:var(--font-serif);font-size:19px;font-weight:400;margin:0 0 22px;color:var(--color-accent)}.print-footer-links ul{list-style:none;margin:0;padding:0}.print-footer-links a{display:inline-block;padding:8px 0;font-family:var(--font-serif);font-size:20px;line-height:1.3;color:#625c50}.print-footer a{text-decoration:none}.print-footer a:hover{color:var(--color-accent);text-decoration:underline;text-underline-offset:5px}.print-footer a:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}.print-footer-view{margin:26px 0 0;position:relative}.print-footer-view img{display:block;width:100%;height:auto;max-height:480px;object-fit:fill;mix-blend-mode:multiply}.print-footer-bottom{display:flex;align-items:center;gap:24px;max-width:1120px;margin:auto;padding:20px 32px 25px;font-size:11px;color:#6d6558}.print-footer-bottom span{margin-right:auto}
@media(max-width:800px){.print-footer-inner{grid-template-columns:1fr;gap:42px}.print-footer-opening p{font-size:31px;max-width:none}.print-footer-opening p br{display:none}.print-footer-view{margin-top:35px}.print-footer-links{gap:25px}.print-footer-view img{width:130%;max-width:none;margin-left:-15%}}
@media(max-width:480px){.print-footer{padding-top:48px}.print-footer-inner{padding:0 24px;gap:35px}.print-footer-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}.print-footer-links h2{margin-bottom:12px}.print-footer-links a{font-size:19px}.print-footer-view img{width:170%;margin-left:-35%}.print-footer-bottom{flex-wrap:wrap;gap:12px 25px;padding:20px 24px}.print-footer-bottom span{width:100%}}
</style>

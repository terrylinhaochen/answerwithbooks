---
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h2' : 'h3';
---
<section class:list={['tool-access', { standalone }]} data-tool-access aria-labelledby="api-access-heading">
  <div class="access-heading">
    <div><Heading id="api-access-heading">Your keys</Heading><p data-access-count>Personal connections to AWB skills.</p></div>
    <button type="button" class="key-button primary" data-key-open disabled aria-haspopup="dialog"><span aria-hidden="true">＋</span> Create API key</button>
  </div>
  <p class="access-status" role="status" aria-live="polite" data-access-status>Checking access…</p>
  <div class="keys-table-wrap" data-access-table hidden>
    <table class="keys-table"><caption class="sr-only">Your API keys</caption><thead><tr><th scope="col">Name</th><th scope="col">Key</th><th scope="col">Created</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody data-access-keys></tbody></table>
  </div>
  <div class="keys-empty" data-access-empty hidden><svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 7a5 5 0 0 1-7 4.6L6 20H3v-3l8.4-8A5 5 0 1 1 21 7Z"/></svg><p data-key-empty-title>No active API keys</p><span data-key-empty-description>Create a key to connect your agent to AWB.</span></div>
  <div class="access-footer"><p>Copy new keys when created. Existing full keys cannot be recovered.</p><button type="button" class="key-text-button" data-access-refresh>Refresh</button></div>
  {!standalone && <div class="connection-card" data-api-connection hidden>
    <div class="connection-title"><h3>One connection for your skills</h3><a href="/tools/">Browse skills →</a></div>
    <p>Your agent chooses the skill. AWB runs it and returns the result, sources, and limitations.</p>
    <label for="account-api-address">API address</label>
    <div class="connection-address"><input id="account-api-address" data-api-address readonly autocomplete="off" /><button type="button" class="key-button" data-copy-api-address disabled aria-label="Copy API address">Copy</button></div>
    <button type="button" class="key-button connection-copy" data-copy-agent-connection disabled>Copy agent setup</button>
    <p class="connection-hint">Setup text contains no secret. Add your key in your agent’s secure settings.</p>
    <p class="key-feedback" data-connection-copy-status role="status" aria-live="polite"></p>
    <textarea class="connection-manual" data-connection-manual aria-label="Agent setup text to copy" readonly hidden></textarea>
  </div>}
  <a class="connection-billing" href="/billing/">
    <span><strong data-key-billing-title>Billing &amp; task history</strong><span data-key-billing-description>All personal keys use this account’s balance and history.</span></span>
    <span class="connection-billing-action">View billing <span aria-hidden="true">→</span></span>
  </a>
  <dialog class="key-dialog" data-key-dialog aria-labelledby="key-dialog-title" aria-describedby="key-dialog-description">
    <div class="key-dialog-heading"><h2 id="key-dialog-title" data-key-dialog-title>Create API key</h2><button type="button" class="key-close" data-key-close aria-label="Close API key dialog">×</button></div>
    <p class="key-dialog-description" id="key-dialog-description" data-key-dialog-description>Give this key a name so you can recognize the agent using it.</p>
    <form data-access-create>
      <label for="api-key-label">Name</label>
      <input id="api-key-label" name="label" placeholder="e.g. Claude Code on my Mac" required pattern=".*\S.*" maxlength="60" autocomplete="off" autofocus />
      <p class="key-field-note">This key can use the skills enabled for your account.</p>
      <p class="key-error" data-key-create-error role="alert"></p>
      <div class="key-dialog-actions"><button type="button" class="key-button" data-key-close>Cancel</button><button type="submit" class="key-button primary">Create key</button></div>
    </form>
    <div data-access-secret hidden>
      <div class="key-notice">Copy this key now. You won’t be able to see it again.</div>
      <label for="new-api-key">Your API key</label>
      <div class="key-secret-row"><input id="new-api-key" type="password" readonly aria-label="New API key" autocomplete="off" data-key-secret /><button type="button" class="key-text-button" data-key-reveal>Show</button></div>
      <button type="button" class="key-button primary key-copy" data-key-copy>Copy API key</button>
      <p class="key-field-note">Add it to your agent’s secure connection settings. Don’t share it in chat or commit it to code.</p>
      <details class="key-options"><summary>Connection options</summary><div><button type="button" class="key-text-button" data-key-download>Download connection file</button><button type="button" class="key-text-button" data-key-check>Check connection</button></div></details>
      <p class="key-feedback" role="status" aria-live="polite" data-key-status></p>
      <div class="key-dialog-actions"><button type="button" class="key-button" data-key-close>Done</button></div>
    </div>
  </dialog>
  <dialog class="key-dialog" data-key-revoke-dialog aria-labelledby="revoke-key-title">
    <div class="key-dialog-heading"><h2 id="revoke-key-title">Revoke API key?</h2><button type="button" class="key-close" data-revoke-close aria-label="Close revoke dialog">×</button></div>
    <p class="key-dialog-description">Agents using <strong data-revoke-name></strong> will lose access for future requests. This cannot be undone. Existing tasks and billing history will remain; other keys will keep working.</p>
    <p class="key-error" role="alert" data-revoke-error></p>
    <div class="key-dialog-actions"><button type="button" class="key-button" data-revoke-close>Cancel</button><button type="button" class="key-button danger" data-revoke-confirm>Revoke key</button></div>
  </dialog>
</section>
<style>
  .connection-card{margin-top:28px;padding:22px;border:1px solid var(--color-line);border-radius:12px;background:var(--color-card)}.connection-title{display:flex;align-items:center;justify-content:space-between;gap:16px}.connection-title h3{font-size:15px;font-weight:600}.connection-title a{font-size:12px;color:var(--color-soft);white-space:nowrap}.connection-card>p{font-size:13px;color:var(--color-soft);line-height:1.7;margin-top:9px}.connection-card label{display:block;margin:18px 0 7px;font-size:12px;color:var(--color-faint)}.connection-address{display:flex;align-items:center;gap:10px}.connection-address input{min-width:0;width:100%;padding:10px 12px;border:1px solid var(--color-line);border-radius:8px;background:var(--color-wash);font:12px/1.5 monospace;color:var(--color-soft)}.connection-copy{margin-top:16px}.connection-card>.connection-hint{font-size:12px;color:var(--color-faint)}.connection-manual{width:100%;height:170px;margin-top:12px;padding:12px;font:12px/1.5 monospace;border:1px solid var(--color-line);border-radius:8px}.connection-billing{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px 0;margin-top:12px;border-bottom:1px solid var(--color-line);text-decoration:none;color:var(--color-ink)}.connection-billing strong{display:block;font-size:14px;font-weight:600}.connection-billing strong+span{display:block;margin-top:5px;color:var(--color-soft);font-size:12px;line-height:1.6}.connection-billing-action{white-space:nowrap;font-size:13px}.connection-billing:hover .connection-billing-action{text-decoration:underline;text-underline-offset:4px}@media(max-width:640px){.connection-card{padding:18px}.connection-title{align-items:flex-start;flex-direction:column;gap:8px}.connection-billing{align-items:flex-start;gap:14px;flex-direction:column}}
  .key-field-note{font-size:12px;color:var(--color-faint);line-height:1.7;margin-top:12px}
  [hidden]{display:none!important}.tool-access{margin-top:24px;border-top:1px solid var(--color-line);padding-top:22px;font-size:14px;line-height:1.5}.tool-access.standalone{margin:0;border:0;padding:0}.access-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}.access-heading :is(h2,h3){font-size:17px;font-weight:600}.access-heading p{color:var(--color-faint);font-size:13px;margin-top:4px}.key-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--color-line);border-radius:8px;background:var(--color-card);color:var(--color-ink);padding:10px 15px;font:inherit;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap}.key-button.primary{background:var(--color-ink);border-color:var(--color-ink);color:#fff}.key-button.danger{background:#b42318;border-color:#b42318;color:#fff}.key-button:hover{filter:brightness(.94)}button:disabled{opacity:.45;cursor:default}.key-text-button{font:inherit;font-size:13px;color:var(--color-soft);cursor:pointer;text-decoration:underline;text-underline-offset:4px}.access-status{color:var(--color-soft);margin:12px 0;overflow-wrap:anywhere}.access-status:empty{display:none}.keys-table-wrap{border:1px solid var(--color-line);border-radius:12px;overflow:hidden;background:var(--color-card)}.keys-table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.keys-table th{font-weight:500;color:var(--color-faint);padding:14px 16px;background:var(--color-wash);white-space:nowrap}.keys-table :global(td){padding:17px 16px;border-top:1px solid var(--color-line);overflow-wrap:anywhere}.keys-table :global(td:first-child){font-weight:500}.keys-table :global(code){font-size:12px;white-space:nowrap;color:var(--color-soft)}.keys-table :global(.key-state){display:inline-flex;gap:6px;align-items:center;color:#327255;font-size:12px;white-space:nowrap}.keys-table :global(.key-state::before){content:'';width:5px;height:5px;border-radius:50%;background:currentColor}.keys-table :global(.key-state.revoked){color:var(--color-faint)}.keys-table :global(.key-revoke){font:inherit;font-size:12px;color:#a3342b;background:none;border:0;cursor:pointer}.keys-table :global(td:last-child){text-align:right}.keys-empty{text-align:center;padding:45px 20px;background:var(--color-card);border:1px dashed var(--color-line);border-radius:12px}.keys-empty svg{margin:0 auto 14px;color:var(--color-faint)}.keys-empty p{font-weight:500}.keys-empty span{display:block;margin-top:7px;color:var(--color-faint);font-size:13px}.access-footer{display:flex;justify-content:space-between;gap:20px;margin-top:16px;color:var(--color-faint);font-size:12px}.key-dialog{margin:auto;width:min(480px,calc(100vw - 32px));max-height:calc(100dvh - 48px);overflow-y:auto;scrollbar-width:none;border:1px solid var(--color-line);border-radius:16px;padding:28px;background:var(--color-card);color:var(--color-ink);box-shadow:0 24px 90px #0002}.key-dialog::-webkit-scrollbar{display:none}.key-dialog::backdrop{background:#15151560;backdrop-filter:blur(3px)}.key-dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.key-dialog-heading h2{font:600 21px/1.3 var(--font-sans)}.key-close{font:24px/1 var(--font-sans);color:var(--color-faint);cursor:pointer;padding:4px;background:none;border:0}.key-dialog-description{color:var(--color-soft);font-size:14px;line-height:1.6;margin:12px 0 24px}.key-dialog label{display:block;font-weight:500;margin:18px 0 8px}.key-dialog input{display:block;box-sizing:border-box;width:100%;min-width:0;border:1px solid var(--color-line);border-radius:8px;background:#fff;padding:12px;font:inherit;color:var(--color-ink)}.key-dialog input::placeholder{color:var(--color-faint)}.key-dialog-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:26px;padding-top:20px;border-top:1px solid var(--color-line)}.key-error{font-size:13px;color:#a3342b;margin-top:12px;overflow-wrap:anywhere}.key-error:empty,.key-feedback:empty{display:none}.key-notice{padding:12px 14px;background:#fff9e9;border:1px solid #eedbab;color:#795315;font-size:13px;border-radius:9px;line-height:1.6}.key-secret-row{display:flex;gap:12px;align-items:center}.key-secret-row input{font-family:monospace}.key-copy{width:100%;margin-top:14px}.key-options{border-top:1px solid var(--color-line);padding-top:16px;margin-top:20px;font-size:12px;color:var(--color-soft)}.key-options summary{cursor:pointer}.key-options div{display:flex;flex-wrap:wrap;gap:16px;margin-top:12px}.key-feedback{margin-top:14px;font-size:13px;color:var(--color-soft)}button:focus-visible,summary:focus-visible,input:focus-visible{outline:2px solid var(--color-ink);outline-offset:3px}@media(max-width:640px){.access-heading{align-items:flex-start;flex-wrap:wrap;gap:14px}.keys-table thead{display:none}.keys-table :global(tr){display:grid;grid-template-columns:minmax(0,1fr) auto;padding:16px;gap:10px;border-bottom:1px solid var(--color-line)}.keys-table :global(tr:last-child){border-bottom:0}.keys-table :global(td){border:0;padding:0}.keys-table :global(td:nth-child(2)){grid-column:1;grid-row:2}.keys-table :global(td:nth-child(3)){grid-column:1;grid-row:3;color:var(--color-faint);font-size:12px}.keys-table :global(td:nth-child(3)::before){content:'Created '}.keys-table :global(td:nth-child(4)){grid-column:2;grid-row:1}.keys-table :global(td:last-child){grid-column:2;grid-row:3}.access-footer{align-items:flex-start}.key-dialog{padding:22px}}
</style>

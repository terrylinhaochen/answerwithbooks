---
import { readingLists } from '../lib/reading-lists';
const { lists = readingLists, title = 'Choose a book for the task', compact = false } = Astro.props;
---
{lists.length > 0 && <section class="awb-section py-10" data-reading-list-links>
  <p class="awb-eyebrow">Reading paths</p>
  <h2 class="mt-2 font-serif text-3xl">{title}</h2>
  <p class="mt-3 max-w-2xl text-soft">Compare the books by the problem they help solve, then start with the one that fits your situation.</p>
  <div class={`mt-6 grid gap-4 ${compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
    {lists.map(list => <a href={`/reading-lists/${list.slug}/`} class="awb-card-link block p-5">
      <h3 class="font-serif text-xl">{list.title}</h3>
      <p class="mt-3 text-sm leading-relaxed text-soft">{list.description}</p>
      <span class="mt-4 block text-sm text-accent">Compare {list.choices.length} books →</span>
    </a>)}
  </div>
  <a class="mt-5 inline-block text-sm underline underline-offset-4" href="/reading-lists/">All reading paths</a>
</section>}

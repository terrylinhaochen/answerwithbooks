---
import GuideCover from './GuideCover.astro';

interface Props {
  guide: {
    slug: string;
    title: string;
    description: string;
    minutes: number;
    audience: string;
    categories: string[];
  };
  featured?: boolean;
  hidden?: boolean;
}
const { guide, featured = false, hidden = false } = Astro.props;
---

<a
  href={`/guides/${guide.slug}/`}
  class="awb-card-link flex h-full flex-col p-5"
  data-featured-guide={featured ? guide.slug : undefined}
  data-capability-guide={!featured ? '' : undefined}
  data-filter-item={!featured ? '' : undefined}
  data-categories={!featured ? JSON.stringify(guide.categories) : undefined}
  data-search={!featured ? `AI ${guide.title} ${guide.description} ${guide.audience}`.toLowerCase() : undefined}
  hidden={hidden}
>
  <GuideCover slug={guide.slug} class="mb-5" />
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-full border border-line px-2.5 py-1 text-xs font-semibold" data-guide-ai-tag>AI</span>
    <p class="text-sm text-faint">{guide.minutes} min · {guide.audience}</p>
  </div>
  <h3 class="mt-4 font-serif text-2xl leading-tight">{guide.title}</h3>
  <p class="mt-3 flex-1 leading-relaxed text-soft">{guide.description}</p>
  <span class="mt-5 text-sm font-semibold">Open guide →</span>
</a>

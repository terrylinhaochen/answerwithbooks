---
import Base from '../layouts/Base.astro';
import GuideQuestion from './GuideQuestion.astro';
import FaqList from './FaqList.astro';
import { faqJsonLd } from '../lib/seo';

const { path = '/guides/' } = Astro.props;
const url = `https://answerwithbooks.com${path}`;
const faqs = [
  {question:'What makes these guides different from book summaries?',answer:'Each guide explores a question through original passages from books, with brief context and connections to help the reading flow.'},
  {question:'How are the books chosen?',answer:'The model considers your question and the available books, then suggests sources for you to confirm before creating the reading.'},
  {question:'Where can I revisit my guide?',answer:'Sign in and open Your Guides on this page to resume a reading or an unfinished request. Published readings also appear in All guides.'},
];
const jsonLd = [
  {'@type':'CollectionPage','@id':`${url}#webpage`,url,name:'Answer with Books guides',description:'Questions explored through original book passages.',isPartOf:{'@id':'https://answerwithbooks.com/#website'}},
  faqJsonLd(url,faqs),
];
---
<Base title="Guides through original book passages" description="Explore questions about life and work through original passages from books." path={path} jsonLd={jsonLd}>
  <section class="awb-section pt-16 pb-8">
    <p class="awb-eyebrow">Guides</p>
    <h1 class="awb-display mt-3 text-5xl leading-tight sm:text-6xl">Good ideas, in practice.</h1>
    <p class="awb-copy mt-4 max-w-2xl">
      See how book ideas become better questions, clearer decisions, and useful next steps. Take a guide into your agent to apply it to your own situation.
    </p>
  </section>

  <GuideQuestion />
  <FaqList items={faqs} eyebrow="Guide Q&A" title="How these guides work" width="wide" />
</Base>

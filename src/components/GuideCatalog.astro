---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AnswerRow from './AnswerRow.astro';
import GuideCover from './GuideCover.astro';
import GuideFilters from './GuideFilters.astro';
import GuidePagination from './GuidePagination.astro';
import FaqList from './FaqList.astro';
import QuestionInvite from './QuestionInvite.astro';
import { faqJsonLd } from '../lib/seo';
import { capabilityGuides } from '../lib/capability-guides';
import { CANONICAL_TOPICS, topicsForTags } from '../lib/topics';

const answers = (await getCollection('answers')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const books = await getCollection('books');
const bookTitles = new Map(books.map((b) => [b.id, b.data.title]));
const answerCategories = CANONICAL_TOPICS.map((topic) => ({
  slug: topic.slug,
  label: topic.label,
  description: topic.description,
  count: answers.filter((answer) => topicsForTags(answer.data.tags).some((answerTopic) => answerTopic.slug === topic.slug)).length,
}));
const practicalCategories = [...new Set(capabilityGuides.flatMap(guide => guide.audience.split(' · ')))].map(label => ({
  slug: label.toLowerCase(), label,
  count: capabilityGuides.filter(guide => guide.audience.split(' · ').includes(label)).length,
}));
const { path = '/answers/' } = Astro.props;
const url = `https://answerwithbooks.com${path}`;
const faqs = [
  {
    question: 'What makes these answers different from normal book summaries?',
    answer:
      'Each guide starts with a practical question and useful source-book ideas. After reading, choose your preferred AI to copy the full guide and source digests, then personalize them using context you have shared. No skill installation or link access is required.',
  },
  {
    question: 'How are answers chosen?',
    answer:
      'Answers are chosen from recurring practical questions, then matched to books that can make the answer more useful than generic advice.',
  },
  {
    question: 'How many books does each answer use?',
    answer:
      'Most answers draw on one to three books so the synthesis stays focused and the source trail remains easy to inspect.',
  },
];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: 'AWB guides',
    description:
      'Practical AI workflows and book-backed guidance for career, learning, and everyday decisions.',
    isPartOf: { '@id': 'https://answerwithbooks.com/#website' },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    mainEntity: { '@id': `${url}#itemlist` },
  },
  {
    '@type': 'ItemList',
    '@id': `${url}#itemlist`,
    itemListElement: [...capabilityGuides.map(guide => ({ name: guide.title, url: `https://answerwithbooks.com/guides/${guide.slug}/` })), ...answers.map(answer => ({ name: answer.data.question, url: `https://answerwithbooks.com/answers/${answer.id}/` }))].map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      ...guide,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AWB', item: 'https://answerwithbooks.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: url },
    ],
  },
  {
    ...faqJsonLd(url, faqs),
  },
];
---

<Base
  title={path === '/guides/' ? 'Guides' : 'Answers'}
  description={path === '/guides/' ? 'Practical AI guides for GitHub lead research, X discourse analysis, and audience handoffs, alongside book-backed answers to real questions.' : 'Real questions framed as agent-ready briefs, each grounded in source-book digests and ready for personalized advice.'}
  path={path}
  jsonLd={jsonLd}
>
  <section class="awb-section pt-16 pb-8">
    <p class="awb-eyebrow">Guides</p>
    <h1 class="awb-display mt-3 text-5xl leading-tight sm:text-6xl">Curated guides to help you get started.</h1>
    <p class="awb-copy mt-4 max-w-2xl">
      Practical AI workflows and book-backed guidance for your career, learning, and everyday decisions.
    </p>
  </section>

  <section class="awb-section pb-16" data-guide-catalog>
    <div class="guide-tabs" role="tablist" aria-label="Guide collections" data-guide-tabs>
      <button type="button" id="tab-practical-ai" class="guide-tab" role="tab" aria-selected="true" aria-controls="practical-ai" data-guide-tab="practical-ai">Practical AI</button>
      <button type="button" id="tab-career-learning" class="guide-tab" role="tab" aria-selected="false" aria-controls="career-learning" tabindex="-1" data-guide-tab="career-learning">Career &amp; Learning</button>
    </div>
    <section id="practical-ai" role="tabpanel" aria-labelledby="tab-practical-ai" tabindex="0" data-guide-panel="practical-ai">
      <span id="ai-tutorials" class="scroll-mt-28"></span>
      <h2 class="font-serif text-3xl">Practical AI guides</h2>
      <p class="mt-3 max-w-2xl text-soft">Step-by-step workflows for research, audience insights, and getting work done with AI.</p>
      <GuideFilters id="practical-ai" categories={practicalCategories} count={capabilityGuides.length} />
      <div class="grid gap-4 md:grid-cols-3 scroll-mt-28" data-capability-guides data-filter-list>
        {capabilityGuides.map((guide, index) => (
          <a href={`/guides/${guide.slug}/`} class="awb-card-link flex flex-col p-5" data-filter-item data-categories={JSON.stringify(guide.audience.toLowerCase().split(' · '))} data-search={`${guide.title} ${guide.description} ${guide.audience}`.toLowerCase()} hidden={index >= 6}>
            <GuideCover slug={guide.slug} class="mb-5" />
            <p class="text-sm text-faint">{guide.minutes} min · {guide.audience}</p>
            <h3 class="mt-4 font-serif text-2xl leading-tight">{guide.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-soft">{guide.description}</p>
            <span class="mt-5 text-sm font-semibold">Open guide →</span>
          </a>
        ))}
      </div>
      <GuidePagination count={capabilityGuides.length} />
    </section>
    <section id="career-learning" role="tabpanel" aria-labelledby="tab-career-learning" tabindex="0" data-guide-panel="career-learning" hidden>
      <h2 class="font-serif text-3xl">Career &amp; learning guides</h2>
      <p class="mt-3 max-w-2xl text-soft">Book-backed perspectives on your career, habits, relationships, and the decisions that matter to you.</p>
      <GuideFilters id="career-learning" categories={answerCategories} count={answers.length} />
      <div class="grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-3 scroll-mt-28" data-filter-list>
        {answers.map((answer, index) => (
          <div class="h-full" data-filter-item data-categories={JSON.stringify(topicsForTags(answer.data.tags).map(topic => topic.slug))} data-search={`${answer.data.question} ${answer.data.description} ${answer.data.tags.join(' ')} ${answer.data.books.map(slug => bookTitles.get(slug) ?? slug).join(' ')}`.toLowerCase()} hidden={index >= 6}>
            <AnswerRow answer={answer} bookTitles={bookTitles} />
          </div>
        ))}
      </div>
      <GuidePagination count={answers.length} />
    </section>
    <div class="mt-10"><QuestionInvite /></div>
    <noscript>
      <style is:inline>@layer base{[data-guide-panel][hidden],[data-guide-panel] [data-filter-item][hidden]{display:block!important}}[data-guide-tabs],[data-guide-filter],[data-pagination]{display:none!important}</style>
      <p class="mt-6 text-sm text-soft">All guides are shown because JavaScript is off. Enable it to use tabs, search, and pagination.</p>
    </noscript>
  </section>

  <FaqList items={faqs} eyebrow="Answer Q&A" title="How these guides work" width="wide" />

  <script>
    import '../lib/guide-catalog';
  </script>
</Base>

<style>
  .guide-tabs{display:flex;gap:28px;border-bottom:1px solid var(--color-line);margin-bottom:32px}.guide-tab{padding:14px 2px;border-bottom:2px solid transparent;font-size:15px;font-weight:600;color:var(--color-soft);cursor:pointer}.guide-tab[aria-selected=true]{color:var(--color-ink);border-color:var(--color-ink)}.guide-tab:focus-visible,[role=tabpanel]:focus-visible{outline:2px solid var(--color-ink);outline-offset:4px}[data-guide-panel]{scroll-margin-top:100px}[hidden]{display:none!important}
</style>

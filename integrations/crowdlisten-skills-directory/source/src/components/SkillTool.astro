---
import github from '@lobehub/icons-static-svg/icons/github.svg?url';
import exa from '@lobehub/icons-static-svg/icons/exa.svg?url';
import { skillTools } from '../lib/skill-discovery.mjs';
const { id } = Astro.props;
const image = ({ github, exa })[id];
---
<span class="skill-dependency">
  {image ? <img src={image} width="15" height="15" alt="" /> : <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    {id === 'x' ? <path d="M5 4l14 16M19 4L5 20" /> : id === 'crowdlisten' ? <><path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8 9h8M8 12h5" /></> : id === 'feedback-library' ? <><rect x="6" y="3" width="14" height="17" rx="2" /><path d="M3 7v15h13M10 8h6M10 12h6M10 16h4" /></> : <><path d="M3 5h7l2 2 2-2h7v15h-7l-2 1-2-1H3V5Z" /><path d="M12 7v14" /></>}
  </svg>}
  <span>{skillTools[id] || id}</span>
</span>
<style>.skill-dependency{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--color-soft);white-space:nowrap}.skill-dependency img,.skill-dependency svg{flex-shrink:0}</style>
